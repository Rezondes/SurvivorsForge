{
  "uid": "forge-telemetry",
  "title": "Launcher and downloads",
  "tags": [
    "survivorsforge"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Launcher events per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT day::timestamptz AS time, kind AS metric, count(*) AS value FROM telemetry_events WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Downloads per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT day::timestamptz AS time, source AS metric, sum(count) AS value FROM download_counts WHERE $__timeFilter(day::timestamptz) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Failed installs by addon and code",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT a.slug, e.kind, e.error_code, count(*) AS events FROM telemetry_events e JOIN addons a ON a.id = e.addon_id WHERE e.error_code IS NOT NULL AND $__timeFilter(e.created_at) GROUP BY 1, 2, 3 ORDER BY events DESC LIMIT 50",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Launcher versions of active installations",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT launcher_version, count(DISTINCT install_id) AS installations FROM telemetry_events WHERE install_id IS NOT NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY installations DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Installs by addon",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT a.slug, count(*) FILTER (WHERE e.kind = 'install') AS installs, count(*) FILTER (WHERE e.kind = 'update') AS updates FROM telemetry_events e JOIN addons a ON a.id = e.addon_id WHERE $__timeFilter(e.created_at) GROUP BY 1 ORDER BY installs DESC LIMIT 50",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "API requests per hour by client",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT hour AS time, client AS metric, sum(count) AS value FROM api_request_stats WHERE $__timeFilter(hour) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Launcher downloads",
      "description": "Downloads of the launcher's release files on GitHub over all versions, self-updates included; one point per hourly poll.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT at AS time, downloads AS \"downloads of every version\" FROM launcher_counts WHERE downloads IS NOT NULL AND $__timeFilter(at) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Launchers active in the last 30 days",
      "description": "Launchers of any version that installed or updated an addon in the 30 days before each hourly poll and send an installation ID; the number on /stats.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT at AS time, active_30d AS \"active launchers (30 days)\" FROM launcher_counts WHERE $__timeFilter(at) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Active launchers this hour",
      "description": "Launchers that asked the platform something since the start of this hour, by platform and version; it starts at zero every hour. Only launchers that send their installation ID count; versions before 0.6.4 name no platform (unknown).",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT os AS \"Platform\", version AS \"Version\", count(*) AS \"Launchers\" FROM launcher_active WHERE hour = date_trunc('hour', now()) GROUP BY 1, 2 ORDER BY 3 DESC, 1, 2",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Launchers"
          ],
          "countRows": false
        }
      }
    },
    {
      "id": 10,
      "title": "Active launchers today",
      "description": "Launchers active since midnight (Europe/Berlin), by platform and version; it starts at zero every day. A launcher updated during the day counts under both versions.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT os AS \"Platform\", version AS \"Version\", count(DISTINCT install_id) AS \"Launchers\" FROM launcher_active WHERE hour >= date_trunc('day', now() AT TIME ZONE 'Europe/Berlin') AT TIME ZONE 'Europe/Berlin' GROUP BY 1, 2 ORDER BY 3 DESC, 1, 2",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Launchers"
          ],
          "countRows": false
        }
      }
    }
  ]
}
