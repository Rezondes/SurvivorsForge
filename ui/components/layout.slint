import { Theme } from "../theme.slint";

// Morpheus heading between two gold rules that fade out, like "Class" and "Zone" in the game.
export component SectionHeading inherits HorizontalLayout {
    in property <string> text;
    in property <length> size: Theme.title;
    spacing: 16px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, #00000000 0%, Theme.outline 100%);
        }
    }
    Text {
        text: root.text;
        font-family: Theme.font-display;
        font-size: root.size;
        color: Theme.gold-heading;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, Theme.outline 0%, #00000000 100%);
        }
    }
}

// Scrollable column with a thin gold scrollbar instead of the platform one. Up, Down, Home and
// End scroll it when the focus inside does not use them.
export component ScrollPanel inherits Rectangle {
    in property <length> spacing: 6px;
    // Where it is scrolled to; bound outside, a list rebuilt after the detail view keeps its place.
    in-out property <length> scroll-y <=> flick.content-y;
    property <length> bar: 6px;
    property <length> overflow: max(0px, flick.content-height - flick.height);
    property <length> thumb: overflow == 0 ? root.height : max(32px, root.height * root.height / flick.content-height);

    function scroll-to(y: length) {
        flick.content-y = clamp(y, -root.overflow, 0px);
    }

    keys := FocusScope {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.scroll-to(flick.content-y - 48px);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.scroll-to(flick.content-y + 48px);
                return accept;
            }
            if (event.text == Key.Home) {
                root.scroll-to(0px);
                return accept;
            }
            if (event.text == Key.End) {
                root.scroll-to(-root.overflow);
                return accept;
            }
            reject
        }

        flick := Flickable {
            x: 0;
            y: 0;
            width: root.width - root.bar - 10px;
            height: root.height;
            content-height: max(content.preferred-height, self.height);
            content := VerticalLayout {
                width: flick.width;
                spacing: root.spacing;
                alignment: start;
                @children
            }
        }
    }

    if root.overflow > 0 : Rectangle {
        x: root.width - root.bar;
        y: 0;
        width: root.bar;
        height: root.height;
        border-radius: root.bar / 2;
        border-width: 1px;
        border-color: Theme.line;

        Rectangle {
            x: 0;
            y: (-flick.content-y / root.overflow) * (root.height - root.thumb);
            width: root.bar;
            height: root.thumb;
            border-radius: root.bar / 2;
            background: track.has-hover || track.pressed ? Theme.outline-hover : Theme.outline;
        }

        track := TouchArea {
            width: parent.width + 8px;
            x: -4px;
            height: parent.height;
            function jump() {
                flick.content-y = -clamp((self.mouse-y - root.thumb / 2) / (root.height - root.thumb), 0, 1) * root.overflow;
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.jump();
                }
            }
            moved => {
                if (self.pressed) {
                    self.jump();
                }
            }
        }
    }
}

// Full-window dim layer that swallows clicks to the UI below and centers its child.
export component Overlay inherits Rectangle {
    background: Theme.overlay;
    TouchArea {
        width: parent.width;
        height: parent.height;
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
}

// Panel with a gold-brown rim, used for the main content area.
export component Panel inherits Rectangle {
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
}

export component DialogCard inherits Rectangle {
    in property <string> title;
    width: 500px;
    height: layout.preferred-height;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.outline;
    background: Theme.panel;
    layout := VerticalLayout {
        padding: Theme.gap-loose;
        spacing: 18px;
        SectionHeading {
            text: root.title;
            size: 24px;
        }
        @children
    }
}
