import { Theme } from "../theme.slint";
import { AddonRow } from "types.slint";
import { ActionButton, GlyphButton, RemoveButton } from "buttons.slint";
import { PickBox } from "fields.slint";
import { AddonIcon, Pill, ProgressBar } from "addon-parts.slint";
import { TipArea } from "tooltip.slint";

export component AddonRowView inherits Rectangle {
    in property <AddonRow> addon;
    callback action();
    callback remove();
    callback toggle();
    callback open();
    callback pick();
    // The row itself was clicked: open the detail view.
    callback details();

    // Touch: room for the 44px action button and 44px links stacked in the last column.
    height: Theme.touch ? 104px : 84px;
    // Disabled: the whole card greyed; its power button says "Enable".
    opacity: root.addon.disabled ? 0.55 : 1;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-label: "Details of " + root.addon.name;
    border-width: details-focus.has-focus ? 2px : 1px;
    border-color: details-focus.has-focus ? Theme.outline-active : hover.has-hover ? Theme.outline : Theme.line;
    background: hover.has-hover ? Theme.row-hover : Theme.row;

    hover := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.details(); }
    }

    // Tab reaches it, Space or Return presses it.
    details-focus := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            // Delete removes it, asking first as the bin does.
            if (event.text == Key.Delete && root.addon.can-remove && !root.addon.busy) {
                root.remove();
                return accept;
            }
            if (event.text == " " || event.text == Key.Return) {
                root.details();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        if root.addon.can-pick : VerticalLayout {
            alignment: center;
            PickBox {
                checked: root.addon.picked;
                label: "Pick " + root.addon.name + " for a pack";
                toggled => { root.pick(); }
            }
        }

        VerticalLayout {
            alignment: center;
            AddonIcon {
                width: 50px;
                height: 50px;
                icon: root.addon.icon;
                initial: root.addon.initial;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.addon.name;
                    font-size: Theme.heading;
                    color: Theme.gold-heading;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Pill { text: root.addon.badge; tone: root.addon.badge-tone; }
                }
                if root.addon.new : VerticalLayout {
                    alignment: center;
                    Pill { text: "New"; tone: 1; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: (root.addon.author != "" ? "by " + root.addon.author + "   " : "") + root.addon.version;
                font-size: Theme.meta;
                color: Theme.text-muted;
                overflow: elide;
            }
            Text {
                text: root.addon.warning != "" ? root.addon.warning : root.addon.description;
                font-size: Theme.meta;
                color: root.addon.warning != "" ? Theme.danger : Theme.text;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: 150px;
            // At most two lines: a long failure would run into the next row. The whole text is
            // the tooltip, and the toast of the failure says it too.
            Rectangle {
                height: min(status.preferred-height, Theme.meta * 2.6);
                status := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.addon.status;
                    font-size: Theme.meta;
                    horizontal-alignment: right;
                    wrap: word-wrap;
                    overflow: elide;
                    color: root.addon.busy ? Theme.text-muted
                        : root.addon.status-kind == 1 ? Theme.ok
                        : root.addon.status-kind == 2 ? Theme.warn
                        : root.addon.status-kind == 3 ? Theme.danger
                        : Theme.text-muted;
                }
                if status.preferred-height > self.height : TipArea {
                    width: parent.width;
                    height: parent.height;
                    tip: root.addon.status;
                }
            }
            if root.addon.busy && root.addon.progress >= 0 : ProgressBar {
                value: root.addon.progress;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: Theme.touch ? 160px : 124px;
            if root.addon.action != "" : ActionButton {
                text: root.addon.action;
                enabled: !root.addon.busy;
                clicked => { root.action(); }
            }
            // GitHub as the square icon button of the details, so it never looks like Install: left
            // under it, the bin at the right edge, apart from GitHub.
            HorizontalLayout {
                spacing: 6px;
                if root.addon.can-open : GlyphButton {
                    label: "GitHub";
                    // Code brackets.
                    glyph: "M 5 4 L 1.5 8 L 5 12 M 11 4 L 14.5 8 L 11 12 M 9.5 2.5 L 6.5 13.5";
                    clicked => { root.open(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.addon.can-toggle && !root.addon.busy : GlyphButton {
                    label: (root.addon.disabled ? "Enable " : "Disable ") + root.addon.name;
                    primary: root.addon.disabled;
                    // A power sign.
                    glyph: "M 8 1.5 L 8 7.5 M 4.6 3.6 A 5.5 5.5 0 1 0 11.4 3.6";
                    clicked => { root.toggle(); }
                }
                if root.addon.can-remove && !root.addon.busy : RemoveButton {
                    label: "Remove " + root.addon.name;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// An addon as a tile: the icon large on top, then name, author, summary, its state and buttons.
export component AddonTileView inherits Rectangle {
    in property <AddonRow> addon;
    callback action();
    callback remove();
    callback toggle();
    callback open();
    callback pick();
    callback details();

    // Below the icon: name, author, two lines of summary, badge and state, the main button, the rest.
    out property <length> body-height: Theme.touch ? 256px : 212px;

    // Disabled: the whole card greyed; its power button says "Enable".
    opacity: root.addon.disabled ? 0.55 : 1;
    border-radius: Theme.radius;
    accessible-role: button;
    accessible-label: "Details of " + root.addon.name;
    border-width: details-focus.has-focus ? 2px : 1px;
    border-color: details-focus.has-focus ? Theme.outline-active : hover.has-hover ? Theme.outline : Theme.line;
    background: hover.has-hover ? Theme.row-hover : Theme.row;
    clip: true;

    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.details(); }
    }

    // Tab reaches it, Space or Return presses it.
    details-focus := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            // Delete removes it, asking first as the bin does.
            if (event.text == Key.Delete && root.addon.can-remove && !root.addon.busy) {
                root.remove();
                return accept;
            }
            if (event.text == " " || event.text == Key.Return) {
                root.details();
                return accept;
            }
            reject
        }
    }

    AddonIcon {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.width;
        border-radius: 0;
        border-width: 0;
        icon: root.addon.icon;
        initial: root.addon.initial;
    }
    if root.addon.can-pick : PickBox {
        x: 10px;
        y: 10px;
        checked: root.addon.picked;
        label: "Pick " + root.addon.name + " for a pack";
        toggled => { root.pick(); }
    }
    Rectangle {
        y: parent.width - 1px;
        height: 1px;
        background: Theme.line;
    }

    VerticalLayout {
        y: parent.width;
        height: root.body-height;
        padding: 10px;
        spacing: 4px;
        Text {
            text: root.addon.name;
            font-size: 17px;
            color: Theme.gold-heading;
            overflow: elide;
        }
        Text {
            text: (root.addon.author != "" ? "by " + root.addon.author + "   " : "") + root.addon.version;
            font-size: Theme.meta;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            height: 36px;
            text: root.addon.warning != "" ? root.addon.warning : root.addon.description;
            font-size: Theme.meta;
            color: root.addon.warning != "" ? Theme.danger : Theme.text;
            wrap: word-wrap;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            height: 22px;
            if root.addon.badge != "" : VerticalLayout {
                alignment: center;
                Pill { text: root.addon.badge; tone: root.addon.badge-tone; }
            }
            if root.addon.new : VerticalLayout {
                alignment: center;
                Pill { text: "New"; tone: 1; }
            }
            // One line: a long failure is cut short, and its whole text is the tooltip, as in a row.
            Rectangle {
                horizontal-stretch: 1;
                tile-status := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.addon.status;
                    font-size: Theme.meta;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    color: root.addon.busy ? Theme.text-muted
                        : root.addon.status-kind == 1 ? Theme.ok
                        : root.addon.status-kind == 2 ? Theme.warn
                        : root.addon.status-kind == 3 ? Theme.danger
                        : Theme.text-muted;
                }
                if tile-status.preferred-width > self.width : TipArea {
                    width: parent.width;
                    height: parent.height;
                    tip: root.addon.status;
                }
            }
        }
        if root.addon.busy && root.addon.progress >= 0 : ProgressBar {
            value: root.addon.progress;
        }
        Rectangle { vertical-stretch: 1; }
        if root.addon.action != "" : ActionButton {
            text: root.addon.action;
            enabled: !root.addon.busy;
            clicked => { root.action(); }
        }
        HorizontalLayout {
            spacing: 6px;
            if root.addon.can-open : GlyphButton {
                label: "GitHub";
                // Code brackets.
                glyph: "M 5 4 L 1.5 8 L 5 12 M 11 4 L 14.5 8 L 11 12 M 9.5 2.5 L 6.5 13.5";
                clicked => { root.open(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.addon.can-toggle && !root.addon.busy : GlyphButton {
                label: (root.addon.disabled ? "Enable " : "Disable ") + root.addon.name;
                primary: root.addon.disabled;
                // A power sign.
                glyph: "M 8 1.5 L 8 7.5 M 4.6 3.6 A 5.5 5.5 0 1 0 11.4 3.6";
                clicked => { root.toggle(); }
            }
            if root.addon.can-remove && !root.addon.busy : RemoveButton {
                label: "Remove " + root.addon.name;
                clicked => { root.remove(); }
            }
        }
    }
}

// Tiles in as many columns of at least 170px as fit, like the website's grid. A column stays below the
// 256px of the platform's icons in a normal window, so they are shown smaller, never blown up.
export component AddonTiles inherits Rectangle {
    in property <[AddonRow]> rows;
    callback action(string);
    callback remove(string);
    callback toggle(string);
    callback open(string);
    callback pick(string);
    callback details(string);

    property <length> gap: 12px;
    property <int> columns: max(1, floor((self.width + self.gap) / (170px + self.gap)));
    property <length> cell: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> tile-height: self.cell + (Theme.touch ? 256px : 212px);
    height: ceil(root.rows.length / self.columns) * (self.tile-height + self.gap) - self.gap;

    for row[i] in root.rows : AddonTileView {
        x: mod(i, root.columns) * (root.cell + root.gap);
        y: floor(i / root.columns) * (root.tile-height + root.gap);
        width: root.cell;
        height: root.tile-height;
        addon: row;
        action => { root.action(row.id); }
        remove => { root.remove(row.id); }
        toggle => { root.toggle(row.id); }
        open => { root.open(row.id); }
        pick => { root.pick(row.id); }
        details => { root.details(row.id); }
    }
}
