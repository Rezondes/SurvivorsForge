import { Theme } from "../theme.slint";
import { Shot } from "types.slint";
import { GlyphButton } from "buttons.slint";

// Screenshots shown large over the window, as on the website: the wheel, the buttons, + and - or a
// double click zoom around the pointer, dragging moves a zoomed picture, the arrows step through,
// a click beside the picture, the X or Escape closes.
export component PictureViewer inherits Rectangle {
    in property <[Shot]> shots;
    in-out property <int> index;
    callback close();

    property <Shot> shot: root.shots[root.index];
    property <float> scale: 1;
    property <length> pan-x;
    property <length> pan-y;
    // The picture fitted into the stage at scale 1.
    property <float> ratio: root.shot.image.width > 0 ? root.shot.image.height / root.shot.image.width : 0.5625;
    property <length> fit-width: min(stage.width - 48px, (stage.height - 48px) / root.ratio);
    property <length> shown-width: root.fit-width * root.scale;
    property <length> shown-height: root.shown-width * root.ratio;
    property <length> left: (stage.width - root.shown-width) / 2 + root.pan-x;
    property <length> top: (stage.height - root.shown-height) / 2 + root.pan-y;
    property <length> drag-x;
    property <length> drag-y;

    function step(by: int) {
        root.index = mod(root.index + by + root.shots.length, root.shots.length);
        root.zoom-at(1 / root.scale, stage.width / 2, stage.height / 2);
    }
    // Zooms by `factor` keeping the point (x, y) of the stage where it is.
    function zoom-at(factor: float, x: length, y: length) {
        let scale = min(6, max(1, root.scale * factor));
        let dx = x - stage.width / 2;
        let dy = y - stage.height / 2;
        root.pan-x = scale == 1 ? 0 : dx - (dx - root.pan-x) * scale / root.scale;
        root.pan-y = scale == 1 ? 0 : dy - (dy - root.pan-y) * scale / root.scale;
        root.scale = scale;
    }

    background: #050403F2;

    stage := Rectangle {
        width: parent.width;
        height: parent.height - bar.height;
        clip: true;
        Image {
            x: root.left;
            y: root.top;
            width: root.shown-width;
            height: root.shown-height;
            source: root.shot.image;
            image-fit: fill;
        }
        // Not here yet, or failed: say so instead of a black stage.
        if root.shot.image.width == 0 : Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.shot.failed ? "This screenshot could not be loaded." : "Loading the screenshot...";
            font-size: Theme.body;
            color: Theme.text-muted;
        }
        TouchArea {
            mouse-cursor: root.scale > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.drag-x = root.pan-x;
                    root.drag-y = root.pan-y;
                }
            }
            moved => {
                if (root.scale > 1) {
                    root.pan-x = root.drag-x + self.mouse-x - self.pressed-x;
                    root.pan-y = root.drag-y + self.mouse-y - self.pressed-y;
                }
            }
            clicked => {
                let inside = self.mouse-x >= root.left && self.mouse-x <= root.left + root.shown-width
                    && self.mouse-y >= root.top && self.mouse-y <= root.top + root.shown-height;
                if (!inside) {
                    root.close();
                }
            }
            double-clicked => { root.zoom-at(root.scale > 1 ? 1 / root.scale : 2.5, self.mouse-x, self.mouse-y); }
            scroll-event(event) => {
                root.zoom-at(event.delta-y > 0 ? 1.2 : 1 / 1.2, self.mouse-x, self.mouse-y);
                accept
            }
        }
    }

    bar := Rectangle {
        y: parent.height - self.height;
        height: Theme.touch ? 64px : 54px;
        background: Theme.bg;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            alignment: stretch;
            Text {
                horizontal-stretch: 1;
                text: root.shot.caption;
                font-size: Theme.body;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.shots.length > 1 : Text {
                text: (root.index + 1) + " / " + root.shots.length;
                font-size: Theme.body;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            if root.shots.length > 1 : VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Previous screenshot";
                    glyph: "M 10 3 L 5 8 L 10 13";
                    clicked => { root.step(-1); }
                }
            }
            if root.shots.length > 1 : VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Next screenshot";
                    glyph: "M 6 3 L 11 8 L 6 13";
                    clicked => { root.step(1); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Zoom out";
                    glyph: "M 3 8 L 13 8";
                    clicked => { root.zoom-at(1 / 1.5, stage.width / 2, stage.height / 2); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Zoom in";
                    glyph: "M 3 8 L 13 8 M 8 3 L 8 13";
                    clicked => { root.zoom-at(1.5, stage.width / 2, stage.height / 2); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Fit to the window";
                    glyph: "M 2 6 L 2 2 L 6 2 M 10 2 L 14 2 L 14 6 M 14 10 L 14 14 L 10 14 M 6 14 L 2 14 L 2 10";
                    clicked => { root.zoom-at(1 / root.scale, stage.width / 2, stage.height / 2); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Close";
                    glyph: "M 3 3 L 13 13 M 13 3 L 3 13";
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }

    keys := FocusScope {
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
            } else if (event.text == Key.RightArrow) {
                root.step(1);
            } else if (event.text == Key.LeftArrow) {
                root.step(-1);
            } else if (event.text == "+" || event.text == "=") {
                root.zoom-at(1.5, stage.width / 2, stage.height / 2);
            } else if (event.text == "-") {
                root.zoom-at(1 / 1.5, stage.width / 2, stage.height / 2);
            } else if (event.text == "0") {
                root.zoom-at(1 / root.scale, stage.width / 2, stage.height / 2);
            } else {
                return reject;
            }
            accept
        }
    }
}
