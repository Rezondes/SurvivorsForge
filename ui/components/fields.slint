import { Theme } from "../theme.slint";
import { TipArea } from "tooltip.slint";
import { ScrollPanel } from "layout.slint";

// Single-line text input with the game's gold-rimmed field look.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // What screen readers call the field; the placeholder when empty.
    in property <string> label;
    // Its value was refused: a red border, the reason stands under the field.
    in property <bool> invalid;
    in property <bool> enabled: true;
    callback accepted();
    callback edited(string);
    // The cursor left the field, by Tab or a click elsewhere.
    callback focus-lost();

    public function focus-input() {
        input.focus();
    }

    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: input.has-focus || root.invalid ? 2px : 1px;
    border-color: root.invalid ? Theme.danger : input.has-focus ? Theme.outline-active : hover.has-hover ? Theme.outline-hover : Theme.outline;
    background: Theme.field;

    hover := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.text == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-size: Theme.body;
        // Readable: it often holds the default that an empty field means.
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        accessible-label: root.label != "" ? root.label : root.placeholder;
        single-line: true;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.text-muted;
        selection-background-color: #8A6C3A;
        selection-foreground-color: Theme.gold-bright;
        vertical-alignment: center;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
        changed has-focus => {
            if !self.has-focus {
                root.focus-lost();
            }
        }
    }
}

// Multi-line text input in the look of `Field`, for comments and issues; grows with its text.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    // Each change puts the cursor into the field (a Reply link elsewhere asks for it).
    in property <int> focus-asks;
    changed focus-asks => { input.focus(); }

    public function focus-input() {
        input.focus();
    }

    height: max(96px, input.preferred-height + 20px);
    border-radius: Theme.radius;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.outline-active : hover.has-hover ? Theme.outline-hover : Theme.outline;
    background: Theme.field;

    hover := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.text == "" : Text {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        text: root.placeholder;
        font-size: Theme.body;
        color: Theme.text-muted;
    }

    input := TextInput {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        text <=> root.text;
        enabled: root.enabled;
        accessible-label: root.label != "" ? root.label : root.placeholder;
        single-line: false;
        wrap: word-wrap;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.text-muted;
        selection-background-color: #8A6C3A;
        selection-foreground-color: Theme.gold-bright;
    }
}

// Square tick box in the gold outline style; the tick is a filled square, no glyph needed.
// The text beside a tick box: a click on it ticks the box too, a bigger target than the box.
export component TickLabel inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    min-width: label.min-width;
    preferred-width: label.preferred-width;
    min-height: Theme.touch ? 44px : 24px;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PickBox inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    // Off: dimmed and does not react.
    in property <bool> enabled: true;
    callback toggled();

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    opacity: root.enabled ? 1 : 0.4;
    width: Theme.touch ? 44px : 24px;
    height: self.width;

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: Theme.radius;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.outline;
        background: Theme.field;
        if root.checked : Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: Theme.gold;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    focus := FocusScope {
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled();
                return accept;
            }
            reject
        }
    }
}

// A choice from a list in the game's look, instead of the platform combo box: a field with a gold
// chevron, the list in a panel below it. Up and Down change the choice without opening the list.
export component Dropdown inherits Rectangle {
    // What the closed field shows for each choice.
    in property <[string]> model;
    // Optional, per choice: the text in the open list, and its place in a group (0 plain, 1 heads a
    // group, 2 belongs to the group above), as the website lists subcategories.
    in property <[string]> list-labels;
    in property <[int]> levels;
    in-out property <int> current-index;
    // What screen readers call the choice ("Sort by").
    in property <string> label;
    callback selected(int);

    property <length> item-height: Theme.touch ? 44px : 34px;
    // The entry the keys point at while the list is open.
    property <int> highlight;

    function open() {
        root.highlight = root.current-index;
        popup.show();
    }

    function pick(index: int) {
        if (index >= 0 && index < root.model.length && index != root.current-index) {
            root.current-index = index;
            root.selected(index);
        }
    }

    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.model[root.current-index];
    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: Theme.field;

    Text {
        x: 12px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.model[root.current-index];
        font-size: Theme.body;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }

    Path {
        x: parent.width - 22px;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: "M 0.5 0.5 L 5 5 L 9.5 0.5";
        stroke: touch.has-hover ? Theme.gold-bright : Theme.gold;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.open();
        }
    }

    focus := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.pick(root.current-index + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pick(root.current-index - 1);
                return accept;
            }
            if (event.text == " " || event.text == Key.Return) {
                root.open();
                return accept;
            }
            reject
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.model.length, 8) * root.item-height + 2px;

        Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.outline;
            background: Theme.bg;

            ScrollPanel {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                spacing: 0;

                for label[index] in root.model : Rectangle {
                    height: root.item-height;
                    background: index == root.current-index ? Theme.crimson : item.has-hover || index == root.highlight ? Theme.row-hover : transparent;
                    border-width: index == root.highlight ? 1px : 0;
                    border-color: Theme.outline-active;

                    property <int> level: index < root.levels.length ? root.levels[index] : 0;
                    Text {
                        x: parent.level == 2 ? 32px : 12px;
                        width: parent.width - self.x - 4px;
                        height: parent.height;
                        text: index < root.list-labels.length ? root.list-labels[index] : label;
                        font-size: Theme.body;
                        color: index == root.current-index ? Theme.gold-bright
                            : item.has-hover || parent.level == 1 ? Theme.gold : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(index); }
                    }
                }
            }
        }

        // Up and Down walk the open list, Return picks, Escape closes it unchanged.
        list-keys := FocusScope {
            width: 0;
            height: 0;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.highlight = min(root.highlight + 1, root.model.length - 1);
                } else if (event.text == Key.UpArrow) {
                    root.highlight = max(root.highlight - 1, 0);
                } else if (event.text == Key.Return || event.text == " ") {
                    root.pick(root.highlight);
                    popup.close();
                    focus.focus();
                } else if (event.text == Key.Escape) {
                    popup.close();
                    focus.focus();
                } else {
                    return reject;
                }
                accept
            }
        }
    }
}

// Tiles or a list, as on the website: two halves of one outlined control, the chosen one lit.
export component ViewToggle inherits Rectangle {
    in-out property <bool> tiles;
    callback changed(bool);

    // As tall as the search field beside it.
    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.outline;
    clip: true;

    HorizontalLayout {
        for half[i] in [{ label: "Tiles", on: true }, { label: "List", on: false }] : Rectangle {
            property <bool> lit: root.tiles == half.on;
            accessible-role: button;
            accessible-label: half.label;
            accessible-checked: self.lit;
            // Icons only, named by their tooltip: each half as wide as the toggle is high.
            width: root.height;
            background: self.lit || touch.has-hover ? Theme.control : transparent;
            if i == 1 : Rectangle {
                x: 0;
                width: 1px;
                background: Theme.line;
            }
            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 16;
                viewbox-height: 16;
                // Four squares, or three bars, drawn as outlines so the gaps stay visible.
                commands: half.on ? "M 1.5 1.5 L 6.5 1.5 L 6.5 6.5 L 1.5 6.5 Z M 9.5 1.5 L 14.5 1.5 L 14.5 6.5 L 9.5 6.5 Z M 1.5 9.5 L 6.5 9.5 L 6.5 14.5 L 1.5 14.5 Z M 9.5 9.5 L 14.5 9.5 L 14.5 14.5 L 9.5 14.5 Z"
                    : "M 1 3 L 15 3 M 1 8 L 15 8 M 1 13 L 15 13";
                stroke: lit ? Theme.gold-bright : touch.has-hover ? Theme.gold : Theme.text-muted;
                stroke-width: 1.6px;
            }
            // The lit half carries a gold line under it.
            if lit : Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.gold;
            }
            touch := TipArea {
                tip: half.label;
                mouse-cursor: pointer;
                clicked => {
                    if (!lit) {
                        root.tiles = half.on;
                        root.changed(half.on);
                    }
                }
            }
            if half-focus.has-focus : Rectangle {
                border-width: 2px;
                border-color: Theme.outline-active;
            }
            // Tab reaches it, Space or Return presses it.
            half-focus := FocusScope {
                width: 0;
                height: 0;
                key-pressed(event) => {
                    if (event.text == " " || event.text == Key.Return) {
                        if (!lit) { root.tiles = half.on; root.changed(half.on); }
                        return accept;
                    }
                    reject
                }
            }
        }
    }
}
