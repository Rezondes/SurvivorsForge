import { Theme } from "../theme.slint";
import { IssueLine, IssueReplyRow, VersionLine } from "types.slint";
import { ActionButton, LinkButton } from "buttons.slint";
import { Field, TextArea, Dropdown } from "fields.slint";
import { ScrollPanel } from "layout.slint";
import { Pill, Placeholder } from "addon-parts.slint";

// A list page of the detail view while it loads, after it failed, or with nothing in it.
export component ListState inherits VerticalLayout {
    in property <bool> loading;
    in property <bool> failed;
    in property <bool> empty;
    in property <string> what;
    in property <string> none;
    callback retry();

    spacing: 8px;
    if root.loading : VerticalLayout {
        spacing: 8px;
        accessible-role: text;
        accessible-label: "Loading the " + root.what;
        for i in 3 : Placeholder { height: 40px; }
    }
    if root.failed : HorizontalLayout {
        spacing: 12px;
        Text {
            text: "The " + root.what + " could not be loaded. Check the connection.";
            font-size: Theme.body;
            color: Theme.danger;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ActionButton {
            text: "Try again";
            clicked => { root.retry(); }
        }
    }
    if !root.loading && !root.failed && root.empty : Text {
        text: root.none;
        font-size: Theme.body;
        color: Theme.text-muted;
    }
}

// Text that wraps inside a layout: a Rectangle around it, a HorizontalLayout would measure one line.
component Prose inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text;
    height: body.preferred-height;
    body := Text {
        width: parent.width;
        text: root.text;
        font-size: Theme.body;
        color: root.text-color;
        wrap: word-wrap;
    }
}

// A title, a text and the error under them: the form for a new issue, in the Issues tab.
component NewIssueForm inherits VerticalLayout {
    in-out property <int> kind;
    in-out property <string> title;
    in-out property <string> body;
    in property <bool> sending;
    in property <string> error;
    // The error says the GitHub login ran out: a way to log in again next to it.
    in property <bool> needs-login;
    in property <bool> links-enabled: true;
    callback cancel();
    callback submit();
    callback login();

    spacing: 10px;
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: "New issue";
            font-size: Theme.body;
            color: Theme.gold;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        LinkButton {
            text: "Back to the issues";
            clicked => { root.cancel(); }
        }
    }
    Text {
        text: "Kind";
        font-size: Theme.meta;
        color: Theme.gold;
    }
    Dropdown {
        label: "Kind of issue";
        model: ["Choose the kind", "Bug report", "Feature request", "Question"];
        current-index <=> root.kind;
    }
    Text {
        text: "Title";
        font-size: Theme.meta;
        color: Theme.gold;
    }
    Field {
        text <=> root.title;
        placeholder: "A short summary, e.g. Crash when opening the map";
        label: "Issue title";
        enabled: !root.sending;
    }
    Text {
        text: "Description";
        font-size: Theme.meta;
        color: Theme.gold;
    }
    TextArea {
        text <=> root.body;
        placeholder: "What happens, and what did you expect?";
        submitted => { if (!root.sending) { root.submit(); } }
        label: "Issue description";
        enabled: !root.sending;
    }
    if root.error != "" : Text {
        text: "Error: " + root.error;
        font-size: Theme.meta;
        color: Theme.danger;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 10px;
        if root.needs-login : ActionButton {
            text: "Log in again";
            enabled: root.links-enabled;
            clicked => { root.login(); }
        }
        ActionButton {
            text: root.sending ? "Sending" : "Create issue";
            primary: true;
            enabled: !root.sending;
            clicked => { root.submit(); }
        }
    }
}

// The Issues tab: the open issues; one opens here with its replies. Logged in with GitHub, issues
// are written and answered here when the addon takes them on the platform (`writable`).
export component IssuesView inherits VerticalLayout {
    in property <[IssueLine]> rows;
    in property <int> open-count;
    in property <bool> loading;
    in property <bool> failed;
    in property <bool> links-enabled: true;
    in property <bool> logged-in;
    in property <bool> writable;
    // 0 the list, 1 the form for a new issue, 2 one issue.
    in property <int> mode;
    in-out property <int> new-kind;
    in-out property <string> new-title;
    in-out property <string> new-body;
    in property <bool> sending;
    in property <string> send-error;
    in property <bool> needs-login;
    // The issue shown (`mode` 2).
    in property <int> issue-number;
    in property <string> issue-title;
    in property <string> issue-meta;
    in property <string> issue-body;
    in property <bool> issue-closed;
    in property <bool> issue-locked;
    in property <[IssueReplyRow]> replies;
    in property <bool> issue-loading;
    in property <bool> issue-failed;
    in-out property <string> reply-draft;
    // An issue's number, or 0 for the whole list, on the website.
    callback open(int);
    callback report();
    callback retry();
    // Shows an issue here.
    callback show(int);
    callback back();
    callback new-issue();
    callback submit();
    callback send-reply();
    callback login();

    spacing: 12px;

    if root.mode == 1 : NewIssueForm {
        vertical-stretch: 1;
        kind <=> root.new-kind;
        title <=> root.new-title;
        body <=> root.new-body;
        sending: root.sending;
        error: root.send-error;
        needs-login: root.needs-login;
        links-enabled: root.links-enabled;
        cancel => { root.back(); }
        submit => { root.submit(); }
        login => { root.login(); }
    }

    if root.mode == 2 : HorizontalLayout {
        spacing: 12px;
        LinkButton {
            text: "< All issues";
            clicked => { root.back(); }
        }
        Rectangle { horizontal-stretch: 1; }
        LinkButton {
            text: "Open on the website";
            clicked => { root.open(root.issue-number); }
        }
    }
    if root.mode == 2 : ScrollPanel {
        vertical-stretch: 1;
        spacing: 12px;
        ListState {
            loading: root.issue-loading;
            failed: root.issue-failed;
            empty: false;
            what: "issue";
            none: "";
            retry => { root.show(root.issue-number); }
        }
        if !root.issue-loading && !root.issue-failed : VerticalLayout {
            spacing: 12px;
            Prose {
                text: root.issue-title + " #" + root.issue-number;
                text-color: Theme.gold-heading;
            }
            Text {
                text: (root.issue-closed ? "Closed. " : "Open. ") + root.issue-meta;
                font-size: Theme.meta;
                color: Theme.text-muted;
            }
            Prose { text: root.issue-body; }
            for reply in root.replies : Rectangle {
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: Theme.radius;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: reply.author + " · " + reply.date;
                        font-size: Theme.meta;
                        color: Theme.gold;
                    }
                    Prose { text: reply.body; }
                }
            }
            if root.writable && root.issue-locked : Text {
                text: "This issue is locked. Only the repo's team can reply.";
                font-size: Theme.meta;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            if root.writable && root.logged-in && !root.issue-locked : VerticalLayout {
                spacing: 8px;
                TextArea {
                    text <=> root.reply-draft;
                    submitted => { if (!root.sending) { root.send-reply(); } }
                    placeholder: "Your reply";
                    label: "Your reply";
                    enabled: !root.sending;
                }
                if root.send-error != "" : Text {
                    text: "Error: " + root.send-error;
                    font-size: Theme.meta;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    if root.needs-login : ActionButton {
                        text: "Log in again";
                        enabled: root.links-enabled;
                        clicked => { root.login(); }
                    }
                    ActionButton {
                        text: root.sending ? "Sending" : "Send reply";
                        primary: true;
                        enabled: !root.sending && root.reply-draft != "";
                        clicked => { root.send-reply(); }
                    }
                }
            }
            if root.writable && !root.logged-in && !root.issue-locked : HorizontalLayout {
                alignment: start;
                spacing: 10px;
                ActionButton {
                    text: "Log in to write";
                    enabled: root.links-enabled;
                    clicked => { root.login(); }
                }
                if !root.links-enabled : Text {
                    text: "Log in in Desktop Mode to write.";
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.mode == 0 : HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.loading ? "Open issues" : root.open-count == 1 ? "1 open issue" : root.open-count + " open issues";
            font-size: Theme.body;
            color: Theme.gold;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        LinkButton {
            text: "All issues on the website";
            clicked => { root.open(0); }
        }
        if root.writable && root.logged-in : ActionButton {
            text: "New issue";
            clicked => { root.new-issue(); }
        }
        // Game Mode opens no browser: say so next to the greyed button.
        if root.writable && !root.logged-in && !root.links-enabled : Text {
            text: "Log in in Desktop Mode to write.";
            font-size: Theme.meta;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        if root.writable && !root.logged-in : ActionButton {
            text: "Log in to write";
            enabled: root.links-enabled;
            clicked => { root.login(); }
        }
        if !root.writable : ActionButton {
            text: "Report a bug";
            enabled: root.links-enabled;
            clicked => { root.report(); }
        }
    }
    if root.mode == 0 : ScrollPanel {
        vertical-stretch: 1;
        spacing: 6px;
        ListState {
            loading: root.loading;
            failed: root.failed;
            empty: root.rows.length == 0;
            what: "issues";
            none: "No open issues.";
            retry => { root.retry(); }
        }
        for issue in root.rows : Rectangle {
            accessible-role: button;
            accessible-label: "#" + issue.number + " " + issue.title;
            accessible-action-default => { root.show(issue.number); }
            height: 52px;
            border-radius: Theme.radius;
            border-width: open-focus.has-focus ? 2px : 1px;
            border-color: open-focus.has-focus ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.line;
            background: touch.has-hover ? Theme.row-hover : Theme.row;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: issue.title;
                        font-size: Theme.body;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: "#" + issue.number + " opened " + issue.date + (issue.author != "" ? " by " + issue.author : "");
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
                if issue.comments > 0 : Text {
                    text: issue.comments == 1 ? "1 comment" : issue.comments + " comments";
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show(issue.number); }
            }
            // Tab reaches it, Space or Return presses it.
            open-focus := FocusScope {
                width: 0;
                height: 0;
                key-pressed(event) => {
                    if (event.text == " " || event.text == Key.Return) {
                        root.show(issue.number);
                        return accept;
                    }
                    reject
                }
            }
        }
    }
}

// The Versions tab: every version the platform knows, newest first. The newest is what installs and
// updates by default; an older one can be installed here, for an addon that broke.
export component VersionsView inherits VerticalLayout {
    in property <[VersionLine]> rows;
    in property <bool> loading;
    in property <bool> failed;
    // An install of this addon runs: the buttons wait.
    in property <bool> busy;
    callback retry();
    callback install(string);

    spacing: 12px;

    Text {
        text: "Versions";
        font-size: Theme.body;
        color: Theme.gold;
    }
    ScrollPanel {
        vertical-stretch: 1;
        spacing: 6px;
        ListState {
            loading: root.loading;
            failed: root.failed;
            empty: root.rows.length == 0;
            what: "versions";
            none: "No versions yet.";
            retry => { root.retry(); }
        }
        for version in root.rows : Rectangle {
            height: 52px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.row;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: version.name + (version.prerelease ? "  (pre-release)" : "") + (version.newest ? "  (newest)" : "");
                        font-size: Theme.body;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: version.date + "   " + (version.downloads == 1 ? "1 download" : version.downloads + " downloads");
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: version.trust;
                        tone: version.trust-kind;
                    }
                }
                if version.installed : Text {
                    width: 90px;
                    text: version.held ? "Installed, kept" : "Installed";
                    font-size: Theme.meta;
                    color: version.held ? Theme.warn : Theme.gold;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !version.installed : VerticalLayout {
                    width: 90px;
                    alignment: center;
                    if version.can-install : ActionButton {
                        text: "Install";
                        enabled: !root.busy;
                        clicked => { root.install(version.tag); }
                    }
                }
            }
        }
    }
}
