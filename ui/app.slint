import { Theme } from "theme.slint";
import {
    AddonRow, ActionButton, TabButton, SectionHeading, Field, ScrollPanel, AddonRowView,
    Overlay, Panel, DialogCard, TitleBar, ResizeEdges, LinkButton, ProgressBar, Dropdown, AddonDetail, DetailView, PickBox, TickLabel,
    AboutBlock, Shot, PictureViewer, ViewToggle, AddonTiles, CommentRow, CommentsView, GlyphButton, TipState, TooltipLayer,
    IssueLine, IssueReplyRow, IssuesView, VersionLine, VersionsView, AddonIcon, TextArea,
    UpdateResult, UpdateResultsDialog, BackupLine, ProfileLine, RemoveButton, Pill
} from "components.slint";
import { Toast, ToastStack } from "@toast/toast.slint";

export { AddonRow, AddonDetail, AboutBlock, Shot, Theme, CommentRow, Toast, IssueLine, IssueReplyRow, VersionLine, UpdateResult, BackupLine, ProfileLine }
export { Splash } from "splash.slint";

// An AddOns folder found on this machine: short label for the button, full path to use.
export struct Suggestion {
    label: string,
    path: string,
}

// Shown under a path field when there is no file dialog to browse with.
component TypePathHint inherits Text {
    in property <bool> game-mode;
    text: "Type the full path to the AddOns folder." + (root.game-mode ? " Press STEAM + X for the on-screen keyboard." : "");
    font-size: Theme.meta;
    color: Theme.text-muted;
    wrap: word-wrap;
}

component SetupView inherits Rectangle {
    in-out property <string> path;
    // Both go once the path is typed again: they were about the old one.
    in-out property <string> error;
    in-out property <string> warning;
    in property <string> example;
    in property <bool> file-dialog;
    in property <bool> game-mode;
    // AddOns folders found on this machine, offered for one click.
    in property <[Suggestion]> suggestions;
    in property <bool> searching;
    callback browse();
    callback confirm();
    callback pick(string);
    callback quit();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Panel {
                width: 600px;
                VerticalLayout {
                    padding: 32px;
                    spacing: 18px;
                    Text {
                        text: "SurvivorsForge";
                        font-family: Theme.font-display;
                        font-size: Theme.logo;
                        color: Theme.gold-heading;
                        horizontal-alignment: center;
                    }
                    SectionHeading {
                        text: "AddOns folder";
                        size: 22px;
                    }
                    Text {
                        text: "Select the AddOns folder of Azeroth Survivors. It sits next to the game's executable, for example " + root.example + ".";
                        font-size: Theme.body;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-tight;
                        Field {
                            text <=> root.path;
                            placeholder: "AddOns folder";
                            label: "AddOns folder path";
                            accepted => { root.confirm(); }
                            edited(_) => {
                                root.error = "";
                                root.warning = "";
                            }
                        }
                        if root.file-dialog : ActionButton {
                            text: "Browse...";
                            clicked => { root.browse(); }
                        }
                    }
                    if !root.file-dialog : TypePathHint {
                        game-mode: root.game-mode;
                    }
                    if root.error != "" : Text {
                        text: "Error: " + root.error;
                        font-size: Theme.body;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                    if root.warning != "" : Text {
                        text: root.warning;
                        font-size: Theme.body;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }
                    // One row tall from the start, so the list arriving doesn't move Continue much.
                    VerticalLayout {
                        spacing: 6px;
                        min-height: 34px;
                        if root.searching : Text {
                            text: "Searching this computer for the AddOns folder...";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                        }
                        if !root.searching && root.suggestions.length == 0 : Text {
                            text: "No AddOns folder found automatically. If the game never ran yet, start it once so it creates the folder. Then "
                                + (root.file-dialog ? "use Browse or type the path." : "type the path.");
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.suggestions.length > 0 : Text {
                            text: "Found on this computer. Select one to use it:";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                        }
                        for suggestion in root.suggestions : ActionButton {
                            text: "Use " + suggestion.label;
                            min-width: 0;
                            clicked => { root.pick(suggestion.path); }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.gap-tight;
                        if root.game-mode : ActionButton {
                            text: "Quit";
                            large: true;
                            clicked => { root.quit(); }
                        }
                        ActionButton {
                            text: root.warning != "" ? "Use This Folder Anyway" : "Continue";
                            primary: true;
                            large: true;
                            enabled: root.path != "";
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    // The height of the group's first line: the label stands beside it, not in the middle of a
    // tall group. A field or a dropdown by default; tick boxes and hints pass their own.
    in property <length> first-line: Theme.touch ? 44px : 38px;
    spacing: Theme.gap-loose;
    VerticalLayout {
        alignment: start;
        Text {
            width: 180px;
            height: max(root.first-line, self.preferred-height);
            text: root.label;
            font-size: 16px;
            color: Theme.gold;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    @children
}

// A line under a settings field, lined up with the fields.
component FieldHint inherits HorizontalLayout {
    in property <string> text;
    padding-left: 180px + Theme.gap-loose;
    Text {
        text: root.text;
        font-size: Theme.meta;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

// The reason a settings field was refused, under it and lined up with the fields.
component FieldError inherits HorizontalLayout {
    in property <string> text;
    padding-left: 180px + Theme.gap-loose;
    Text {
        text: "Error: " + root.text;
        font-size: Theme.meta;
        color: Theme.danger;
        wrap: word-wrap;
    }
}

component SettingsView inherits VerticalLayout {
    in-out property <string> path;
    // "Not set" first, then the platform's game versions; empty without the platform.
    in property <[string]> game-versions;
    in-out property <int> game-index;
    // The update check runs: the game versions may still come.
    in property <bool> checking;
    in property <bool> game-versions-failed;
    in property <string> version;
    in property <bool> file-dialog;
    in property <bool> game-mode;
    // Another platform than the built-in one; empty uses the address shown as placeholder.
    in-out property <string> api-url;
    // Why a field was not saved, under it; empty when it was.
    in property <string> path-error;
    in property <string> api-error;
    in property <string> web-error;
    in-out property <string> web-url;
    in property <string> api-default;
    in property <string> web-default;
    // Anonymous counts for the platform's statistics; the ID only while they are on.
    in-out property <bool> telemetry;
    in-out property <bool> send-install-id;
    // Install checked updates of every addon on their own.
    in-out property <bool> auto-update;
    // What the launcher does once the game runs: stay open, minimize, close.
    in property <[string]> after-launch-labels;
    in-out property <int> after-launch-index;
    // Disabled addons get their updates too.
    in-out property <bool> update-disabled;
    // Look for updates on their own while the launcher is open, and how often.
    in-out property <bool> periodic-check;
    in property <[string]> check-labels;
    in-out property <int> check-index;
    // The profiles, and the name typed for a new one.
    in property <[ProfileLine]> profiles;
    in-out property <string> profile-name;
    in property <string> profile-error;
    callback profile-save();
    callback profile-apply(int);
    callback profile-delete(int);
    // Copies the string of a profile (the window does it, outside this scrolling page); and one
    // pasted to import.
    callback profile-copy(int);
    in-out property <string> profile-import-text;
    callback profile-import(string);
    // Keep the profiles in the platform account too (only while logged in).
    in-out property <bool> sync-profiles;
    // The backups of the addon settings, newest first, and how many stay.
    in property <[BackupLine]> backups;
    // All the backups there are; `backups` holds the newest 3 unless all are shown.
    in property <int> backups-total;
    in-out property <bool> backups-all;
    callback backups-toggled();
    in property <[string]> backups-kept-labels;
    in-out property <int> backups-kept-index;
    callback backup-restore(int);
    // The GitHub login on the platform: the login name while logged in, else empty.
    in property <string> account-login;
    in property <string> account-initial;
    in property <image> account-avatar;
    // The browser is open for the login; Cancel stops waiting.
    in property <bool> account-busy;
    in property <string> account-error;
    // Logged in to GitHub alone (device flow), without the platform: the GitHub login name.
    in property <string> account-github-only;
    // The code to enter at github.com/login/device while a device login waits.
    in property <string> account-device-code;
    // The platform cannot be reached, and this build can log in to GitHub alone.
    in property <bool> device-login-offered;
    // The platform cannot be reached: its login cannot work.
    in property <bool> offline;
    // The device code "Copy code" last copied; a new code can be copied again.
    property <string> copied-code;
    // The platform addresses are shown: opened by hand, or a refused one has to be fixed.
    property <bool> advanced-open;
    // The points of what the statistics send are open.
    property <bool> stats-details;
    property <bool> show-advanced: root.advanced-open || root.api-error != "" || root.web-error != "";
    callback login();
    callback login-device();
    callback open-device-page();
    callback login-cancel();
    callback logout();
    callback browse();
    // Tick boxes and the dropdown save at once, text fields on Enter, when they lose focus and
    // when the page is left: not on every key.
    callback save();

    spacing: 16px;
    alignment: start;

    SectionHeading {
        text: "Game";
        size: 20px;
    }
    SettingRow {
        label: "AddOns folder";
        Field {
            text <=> root.path;
            label: "AddOns folder";
            invalid: root.path-error != "";
            accepted => { root.save(); }
            focus-lost => { root.save(); }
        }
        // Centred on the taller field, as the buttons beside the profile fields.
        if root.file-dialog : VerticalLayout {
            alignment: center;
            ActionButton {
                text: "Browse...";
                clicked => { root.browse(); }
            }
        }
    }
    if root.path-error != "" : FieldError { text: root.path-error; }
    if !root.file-dialog : HorizontalLayout {
        padding-left: 180px + Theme.gap-loose;
        TypePathHint {
            game-mode: root.game-mode;
        }
    }
    SettingRow {
        label: "Game version";
        if root.game-versions.length > 1 : Dropdown {
            label: "Game version";
            model: root.game-versions;
            current-index <=> root.game-index;
            selected => { root.save(); }
        }
        // The list comes from the platform: say so instead of dropping the row.
        if root.game-versions.length <= 1 : Text {
            text: root.checking ? "Loading the game versions..."
                : root.game-versions-failed ? "The platform does not answer, so its game versions are not loaded."
                : "The platform lists no game versions yet. Once it does, you choose yours here.";
            font-size: Theme.meta;
            color: Theme.text-muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    if !root.game-mode : SettingRow {
        label: "Once the game runs";
        Dropdown {
            label: "After launching the game";
            model: root.after-launch-labels;
            current-index <=> root.after-launch-index;
            selected => { root.save(); }
        }
    }
    SectionHeading {
        text: "Addons";
        size: 20px;
    }
    SettingRow {
        label: "Updates";
        first-line: Theme.touch ? 44px : 24px;
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                PickBox {
                    label: "Update all addons automatically";
                    checked: root.auto-update;
                    toggled => {
                        root.auto-update = !root.auto-update;
                        root.save();
                    }
                }
                TickLabel {
                    text: "Update all addons automatically";
                    clicked => {
                        root.auto-update = !root.auto-update;
                        root.save();
                    }
                }
            }
            Text {
                text: "Only versions that passed the platform's safety check. Flagged versions wait for you. You can switch this on for single addons in their details.";
                font-size: Theme.meta;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                PickBox {
                    label: "Update disabled addons too";
                    checked: root.update-disabled;
                    toggled => {
                        root.update-disabled = !root.update-disabled;
                        root.save();
                    }
                }
                TickLabel {
                    text: "Update disabled addons too";
                    clicked => {
                        root.update-disabled = !root.update-disabled;
                        root.save();
                    }
                }
            }
            Text {
                text: "Disabled addons wait in AddOns.disabled beside the AddOns folder. On: their updates install there; off: an update waits until the addon is enabled.";
                font-size: Theme.meta;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            // As tall as the dropdown whether it shows or not, the box centred beside its label: the
            // line keeps its height and place when the box is ticked.
            HorizontalLayout {
                spacing: 10px;
                height: Theme.touch ? 44px : 38px;
                VerticalLayout {
                    alignment: center;
                    PickBox {
                        label: "Look for updates while the launcher is open";
                        checked: root.periodic-check;
                        toggled => {
                            root.periodic-check = !root.periodic-check;
                            root.save();
                        }
                    }
                }
                TickLabel {
                    text: "Look for updates while the launcher is open";
                    clicked => {
                        root.periodic-check = !root.periodic-check;
                        root.save();
                    }
                }
                if root.periodic-check : Dropdown {
                    width: 200px;
                    label: "How often to look for updates";
                    model: root.check-labels;
                    current-index <=> root.check-index;
                    selected => { root.save(); }
                }
            }
        }
    }
    SettingRow {
        label: "Profiles";
        first-line: Theme.meta * 1.4;
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "A profile is a set of addons, each on or off. Applying one installs the platform addons it has, enables them and disables all others. Nothing is deleted.";
                font-size: Theme.meta;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            if root.profiles.length == 0 : Text {
                text: "No profiles yet. Save the addons you have now as the first one.";
                font-size: Theme.body;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            for line[index] in root.profiles : HorizontalLayout {
                spacing: 12px;
                Text {
                    text: line.name;
                    font-size: Theme.body;
                    color: line.active ? Theme.gold-heading : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Which profile is applied, at a glance.
                if line.active : VerticalLayout {
                    alignment: center;
                    Pill { text: "Applied"; tone: 1; }
                }
                if line.modified : VerticalLayout {
                    alignment: center;
                    Pill { text: "Changed since"; tone: 2; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: line.count;
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                // Apply and Copy string as buttons; Delete is the bin, as on the addon cards.
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Apply";
                        accessible-label: "Apply the profile " + line.name;
                        clicked => { root.profile-apply(index); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Copy string";
                        accessible-label: "Copy the string of the profile " + line.name;
                        clicked => { root.profile-copy(index); }
                    }
                }
                RemoveButton {
                    label: "Delete the profile " + line.name;
                    clicked => { root.profile-delete(index); }
                }
            }
            Text {
                text: "New profile";
                font-size: Theme.meta;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 10px;
                Field {
                    text <=> root.profile-name;
                    label: "Profile name";
                    placeholder: "Name for the addons you have now";
                    invalid: root.profile-error != "";
                    accepted => { root.profile-save(); }
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Save as profile";
                        clicked => { root.profile-save(); }
                    }
                }
            }
            if root.profile-error != "" : Text {
                text: "Error: " + root.profile-error;
                font-size: Theme.meta;
                color: Theme.danger;
                wrap: word-wrap;
            }
            Text {
                text: "Import a profile";
                font-size: Theme.meta;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 10px;
                Field {
                    text <=> root.profile-import-text;
                    label: "Profile string";
                    placeholder: "Paste a profile string someone sent you (SFP1:...)";
                    accepted => { root.profile-import(root.profile-import-text); }
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Import";
                        enabled: root.profile-import-text != "";
                        clicked => { root.profile-import(root.profile-import-text); }
                    }
                }
            }
            if root.account-login != "" : HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    PickBox {
                        label: "Keep the profiles in my account";
                        checked: root.sync-profiles;
                        toggled => {
                            root.sync-profiles = !root.sync-profiles;
                            root.save();
                        }
                    }
                }
                TickLabel {
                    text: "Keep the profiles in my account, for my other computers";
                    clicked => {
                        root.sync-profiles = !root.sync-profiles;
                        root.save();
                    }
                }
            }
        }
    }
    SettingRow {
        label: "Backups";
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: "Before an update or a removal, the addon settings (saved/ in the game's config folder) are backed up to backups/ there.";
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                Dropdown {
                    width: 200px;
                    label: "Backups to keep";
                    model: root.backups-kept-labels;
                    current-index <=> root.backups-kept-index;
                    selected => { root.save(); }
                }
            }
            if root.backups.length == 0 : Text {
                text: "No backups yet.";
                font-size: Theme.meta;
                color: Theme.text-muted;
            }
            for line[index] in root.backups : HorizontalLayout {
                spacing: 10px;
                Text {
                    text: line.when;
                    font-size: Theme.body;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: line.size;
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: "Restore";
                        accessible-label: "Restore the backup of " + line.when;
                        clicked => { root.backup-restore(index); }
                    }
                }
            }
            if root.backups.length > 0 : Text {
                text: "Restore asks first, and backs up the current settings before it replaces them.";
                font-size: Theme.meta;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            if root.backups-total > 3 : HorizontalLayout {
                alignment: start;
                LinkButton {
                    text: root.backups-all ? "Show the newest 3" : "Show all " + root.backups-total + " backups";
                    clicked => {
                        root.backups-all = !root.backups-all;
                        root.backups-toggled();
                    }
                }
            }
        }
    }
    SectionHeading {
        text: "Account & privacy";
        size: 20px;
    }
    SettingRow {
        label: "GitHub account";
        if root.account-login != "" : HorizontalLayout {
            spacing: 10px;
            alignment: start;
            AddonIcon {
                width: 32px;
                height: 32px;
                icon: root.account-avatar;
                initial: root.account-initial;
            }
            Text {
                text: root.account-login;
                font-size: Theme.body;
                color: Theme.text;
                vertical-alignment: center;
            }
            ActionButton {
                text: "Log out";
                clicked => { root.logout(); }
            }
        }
        if root.account-login == "" && !root.account-busy && root.account-github-only != "" : HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: root.account-github-only + " (GitHub only)";
                font-size: Theme.body;
                color: Theme.text;
                vertical-alignment: center;
            }
            ActionButton {
                text: "Log out";
                clicked => { root.logout(); }
            }
        }
        if root.account-login == "" && !root.account-busy : ActionButton {
            // Logged in to GitHub alone already: this is the platform login on top.
            text: root.account-github-only != "" ? "Log in to SurvivorsForge too" : "Log in with GitHub";
            // Game Mode opens no browser; offline the browser would wait for a dead page.
            enabled: !root.game-mode && !root.offline;
            clicked => { root.login(); }
        }
        if root.account-login == "" && !root.account-busy && root.account-github-only == "" && root.device-login-offered : ActionButton {
            text: "Log in to GitHub only";
            clicked => { root.login-device(); }
        }
        // Two lines: where to go, then the code with its buttons; one line is too wide next to the label.
        if root.account-busy && root.account-device-code != "" : VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Text {
                    text: "Enter this code at";
                    font-size: Theme.body;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                // A link opens the page again (say the first browser tab was closed); Game Mode opens
                // no browser, so there it is the address to type on another device.
                if !root.game-mode : LinkButton {
                    text: "github.com/login/device";
                    clicked => { root.open-device-page(); }
                }
                if root.game-mode : Text {
                    text: "github.com/login/device";
                    font-size: Theme.body;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                // Read-only input: the code can be selected and copied like any text.
                device-code := TextInput {
                    text: root.account-device-code;
                    read-only: true;
                    single-line: true;
                    font-size: 22px;
                    color: Theme.gold-bright;
                    selection-background-color: #8A6C3A;
                    selection-foreground-color: Theme.gold-bright;
                    vertical-alignment: center;
                    accessible-label: "Device code " + root.account-device-code;
                }
                ActionButton {
                    text: root.copied-code == root.account-device-code ? "Copied" : "Copy code";
                    clicked => {
                        device-code.select-all();
                        device-code.copy();
                        device-code.clear-selection();
                        root.copied-code = root.account-device-code;
                    }
                }
                ActionButton {
                    text: "Cancel";
                    clicked => { root.login-cancel(); }
                }
            }
        }
        if root.account-busy && root.account-device-code == "" : HorizontalLayout {
            spacing: 10px;
            Text {
                text: "Waiting for the browser...";
                font-size: Theme.body;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            ActionButton {
                text: "Cancel";
                clicked => { root.login-cancel(); }
            }
        }
    }
    if root.account-error != "" : FieldError { text: root.account-error; }
    FieldHint {
        text: root.device-login-offered && root.account-login == ""
            ? "The SurvivorsForge server cannot be reached. Logging in to GitHub only still gets updates past GitHub's limits for logged-out users; comments and issues need the server."
            : root.offline && root.account-login == ""
            ? "The SurvivorsForge server cannot be reached, so its login waits until it is back."
            : root.game-mode && root.account-login == ""
            ? "Log in from the desktop: Game Mode opens no browser."
            : root.account-login != ""
            ? "You write comments and issues in the launcher as " + root.account-login + "."
            : "Optional. Lets you write comments and issues from the launcher, as on the website.";
    }
    SettingRow {
        label: "Statistics";
        first-line: Theme.touch ? 44px : 24px;
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                PickBox {
                    label: "Count my installs in the public statistics";
                    checked: root.telemetry;
                    toggled => {
                        root.telemetry = !root.telemetry;
                        root.save();
                    }
                }
                TickLabel {
                    text: "Count my installs in the public statistics";
                    clicked => {
                        root.telemetry = !root.telemetry;
                        root.save();
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                padding-left: (Theme.touch ? 44px : 24px) + 10px;
                PickBox {
                    label: "Send an anonymous installation ID";
                    enabled: root.telemetry;
                    checked: root.send-install-id;
                    toggled => {
                        root.send-install-id = !root.send-install-id;
                        root.save();
                    }
                }
                TickLabel {
                    text: "Send an anonymous installation ID";
                    enabled: root.telemetry;
                    clicked => {
                        root.send-install-id = !root.send-install-id;
                        root.save();
                    }
                }
            }
            // What the two boxes send, in the words of telemetry.rs and /stats: one point a line,
            // folded away behind a link; read once, it need not push the page down every time.
            HorizontalLayout {
                alignment: start;
                LinkButton {
                    text: root.stats-details ? "Hide what is sent" : "What is sent?";
                    clicked => { root.stats-details = !root.stats-details; }
                }
            }
            if root.stats-details : VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "•";
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        accessible-role: none;
                    }
                    // A Rectangle around the wrapping text: the layout would measure it as one line.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: point1.preferred-height;
                        point1 := Text {
                            width: parent.width;
                            text: "Sent after an install, update or rollback of a verified addon: the addon and version, whether it worked (a fixed code if not), the launcher version and the operating system.";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "•";
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        accessible-role: none;
                    }
                    // A Rectangle around the wrapping text: the layout would measure it as one line.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: point2.preferred-height;
                        point2 := Text {
                            width: parent.width;
                            text: "Never sent: your name or file contents. No IP address is stored.";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "•";
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        accessible-role: none;
                    }
                    // A Rectangle around the wrapping text: the layout would measure it as one line.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: point3.preferred-height;
                        point3 := Text {
                            width: parent.width;
                            text: "The installation ID is a random number that counts active launchers. The platform forgets it after 90 days.";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
    SettingRow {
        label: "Version";
        Text {
            text: "SurvivorsForge " + root.version;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    // Another platform than the built-in one: set once, if ever. Folded away at the end, open on
    // its own while one of its fields was refused.
    // A row of its own, its link in the column of the fields.
    SettingRow {
        label: "Advanced";
        first-line: Theme.touch ? 44px : 24px;
        HorizontalLayout {
            alignment: start;
            LinkButton {
                text: (root.show-advanced ? "Hide the platform addresses" : "Show the platform addresses")
                    + (!root.show-advanced && (root.api-url != "" || root.web-url != "") ? " (another platform is set)" : "");
                clicked => { root.advanced-open = !root.show-advanced; }
            }
        }
    }
    if root.show-advanced : VerticalLayout {
        spacing: 16px;
        SettingRow {
            label: "Platform API";
            Field {
                text <=> root.api-url;
                placeholder: root.api-default;
                label: "Platform API address";
                invalid: root.api-error != "";
                accepted => { root.save(); }
                focus-lost => { root.save(); }
            }
        }
        if root.api-error != "" : FieldError { text: root.api-error; }
        FieldHint { text: "Empty uses the built-in platform, as shown in grey."; }
        SettingRow {
            label: "Platform website";
            Field {
                text <=> root.web-url;
                placeholder: root.web-default;
                label: "Platform website address";
                invalid: root.web-error != "";
                accepted => { root.save(); }
                focus-lost => { root.save(); }
            }
        }
        if root.web-error != "" : FieldError { text: root.web-error; }
        FieldHint { text: "Empty uses the built-in website."; }
    }
}

export component AppWindow inherits Window {
    title: "SurvivorsForge";
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    min-width: 980px;
    min-height: 660px;
    preferred-width: 1180px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: Theme.font-body;

    in property <string> app-version;
    in property <string> addons-example;

    // Own window frame
    callback start-drag();
    callback start-resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // Steam Deck Game Mode / gamescope: fullscreen without window frame.
    in property <bool> game-mode;
    property <length> title-height: root.game-mode ? 0px : 34px;
    // False without a usable file dialog (no portal, or Game Mode): Browse and Install zip hide.
    in property <bool> file-dialog: true;

    // First start
    in property <bool> needs-setup;
    in-out property <string> setup-path;
    in-out property <string> setup-error;
    in-out property <string> setup-warning;
    in property <[Suggestion]> setup-suggestions;
    in property <bool> setup-searching: true;
    callback setup-browse();
    callback setup-confirm();

    // 0 installed, 1 browse, 2 settings
    in-out property <int> page: 0;
    in property <[AddonRow]> installed-rows;
    in property <[AddonRow]> browse-rows;
    // Browse filter: "All categories" first, subcategories read "Classes: Warrior".
    in property <[string]> category-labels;
    in property <[string]> category-list-labels;
    in property <[int]> category-levels;
    in-out property <int> category-index;
    callback category-changed(int);
    // Addons picked in Browse for an addon pack.
    in property <int> picked-count;
    in property <bool> pack-busy;
    callback row-pick(string);
    callback pack-save();
    callback pack-share();
    callback pack-clear();
    in property <int> installed-total;
    in-out property <string> search;
    callback search-changed(string);

    // Ctrl+F asks the search field for the cursor.
    property <int> search-focus;
    // No dialog or picture is open over the pages, which would take these keys.
    property <bool> keys-free: !root.needs-setup && !root.zoom-open && !root.confirm-open && !root.repo-open && !root.comments-compose-open && !root.results-open;
    // A search, category or safety filter hides some addons.
    property <bool> filtered: root.search != "" || root.category-index > 0 || root.safety-index > 0;
    function clear-filters() {
        root.search = "";
        root.search-changed("");
        root.category-index = 0;
        root.category-changed(0);
        root.safety-index = 0;
        root.safety-changed(0);
    }
    in property <string> addons-dir;
    // Shows the AddOns folder in the file manager.
    callback open-addons-dir();
    in property <int> update-count;
    in property <bool> checking;
    callback check-updates();
    // The platform did not answer: the lists may be old, until a check gets through.
    in property <bool> offline;
    // Why the game can't be started from here; empty when its executable was found.
    in property <string> game-missing;
    // The game started from here still runs.
    in property <bool> game-running;
    // An addon is installed, updated or removed: the game would load its folder half written.
    in property <bool> addons-busy;
    callback launch-game();
    // "Update to v0.133.0" when the game's server has a newer game; empty when up to date.
    in property <string> game-update;
    // What is installed, under the update button.
    in property <string> game-hint;
    in property <bool> game-updating;
    // The running game update's step ("12.0 MB / 48.0 MB") and how full its bar is.
    in property <string> game-step;
    in property <float> game-progress;
    callback update-game();
    callback update-all();
    callback install-zip();
    callback add-repo();
    callback row-action(string);
    callback row-remove(string);
    callback row-toggle(string);
    callback row-open(string);
    // The detail view of one addon, shown on the page it was opened from (-1: none).
    in-out property <int> detail-page: -1;
    in property <AddonDetail> detail;
    // Where Installed and Browse are scrolled to, kept while the detail view covers them.
    property <length> installed-scroll;
    property <length> browse-scroll;
    // Each list shows tiles or rows, as its page last chose (kept in the config).
    in-out property <bool> installed-tiles;
    in-out property <bool> browse-tiles;
    callback view-changed(int, bool);
    // A screenshot or description image shown large over everything.
    property <bool> zoom-open;
    property <[Shot]> zoom-shots;
    property <int> zoom-index;
    callback row-details(string);
    callback detail-website();
    callback detail-link(string);
    // The detail view's sub page: 0 Overview, 1 Screenshots, 2 Issues, 3 Comments, 4 Versions.
    in-out property <int> detail-tab;
    callback detail-tab-changed(int);
    // Browse and Installed: the safety check filter and the order, their choices from
    // `controller::SAFETY_LABELS` and `controller::SORT_LABELS`.
    in property <[string]> safety-labels;
    in property <[string]> sort-labels;
    in-out property <int> safety-index;
    in-out property <int> sort-index;
    callback safety-changed(int);
    callback sort-changed(int);
    // A list page that failed, asked again.
    callback detail-retry(int);
    // Install exactly this version of the detail view's addon (an older one, after a confirmation).
    callback version-install(string);
    in property <[IssueLine]> issues-rows;
    in property <int> issues-open;
    in property <bool> issues-loading;
    in property <bool> issues-failed;
    in property <int> issues-mode;
    in-out property <int> issues-new-kind;
    in-out property <string> issues-new-title;
    in-out property <string> issues-new-body;
    in property <bool> issues-sending;
    in property <string> issues-send-error;
    in property <bool> issues-needs-login;
    in property <int> issue-number;
    in property <string> issue-title;
    in property <string> issue-meta;
    in property <string> issue-body;
    in property <bool> issue-closed;
    in property <bool> issue-locked;
    in property <[IssueReplyRow]> issue-replies;
    in property <bool> issue-loading;
    in property <bool> issue-failed;
    in-out property <string> issue-reply-draft;
    callback issue-show(int);
    callback issues-back();
    callback issues-new();
    callback issues-submit();
    callback issue-send-reply();
    in property <[VersionLine]> versions-rows;
    in property <bool> versions-loading;
    in property <bool> versions-failed;
    // The Comments tab; its rows and how loading them goes.
    in property <[CommentRow]> comments-rows;
    in property <int> comments-waiting;
    in property <bool> comments-failed;
    in property <bool> comments-off;
    in property <bool> comments-more;
    in property <bool> comments-loading-more;
    // The dialog to write a comment or a reply is open.
    in property <bool> comments-compose-open;
    in-out property <string> comments-draft;
    in property <string> comments-reply-to;
    in property <bool> comments-sending;
    in property <string> comments-send-error;
    in property <bool> comments-needs-login;
    callback comments-send();
    callback comments-compose();
    callback comments-reply(int);
    // Closes the comment dialog; what was written stays for the next time.
    callback comments-cancel-reply();
    callback comments-show();
    callback comments-older();
    callback comments-retry();
    callback detail-scan();
    callback detail-auto-update();
    property <bool> showing-detail: root.detail-page == root.page;
    // Room at the end of a list for the toasts over its bottom right, where the row buttons are:
    // the last row scrolls up out from under them.
    property <length> toast-room: root.toasts.length > 0 ? toast-stack.height + 8px : 0px;

    // Running work and how it ended, bottom right (crates/slint-toast).
    in property <[Toast]> toasts;
    callback toast-dismiss(int);
    // A zip is dragged over the window: dropping it installs it.
    in-out property <bool> drop-hover;
    callback toast-action(int);

    // The results of "Update all" and of updates that installed on their own; empty: closed.
    in property <[UpdateResult]> update-results;
    in property <int> update-results-updated;
    in property <bool> update-results-retryable;
    property <bool> results-open: root.update-results.length > 0;
    callback update-result-fix(string);
    callback update-result-notes(string);
    callback update-results-retry();
    callback update-results-close();

    // Settings
    in-out property <string> settings-path;
    in property <[string]> settings-game-versions;
    // The last check got no answer to the game versions (an empty list is an answer).
    in property <bool> settings-game-versions-failed;
    in-out property <int> settings-game-index;
    in-out property <string> settings-api-url;
    in property <string> settings-path-error;
    in property <string> settings-api-error;
    in property <string> settings-web-error;
    in-out property <string> settings-web-url;
    in property <string> settings-api-default;
    in property <string> settings-web-default;
    in-out property <bool> settings-telemetry;
    in-out property <bool> settings-send-install-id;
    in-out property <bool> settings-auto-update;
    in property <[string]> settings-after-launch-labels;
    in-out property <int> settings-after-launch-index;
    in-out property <bool> settings-periodic-check: true;
    in-out property <bool> settings-update-disabled: true;
    in property <[BackupLine]> settings-backups;
    in property <int> settings-backups-total;
    in-out property <bool> settings-backups-all;
    callback backups-toggled();
    in property <[ProfileLine]> settings-profiles;
    in-out property <string> settings-profile-name;
    in property <string> settings-profile-error;
    callback profile-save();
    callback profile-apply(int);
    callback profile-delete(int);
    pure callback profile-string(int) -> string;
    callback profile-copied();
    in-out property <string> settings-profile-import;
    in-out property <bool> settings-sync-profiles;
    callback profile-import(string);
    in property <[string]> settings-backups-kept-labels;
    in-out property <int> settings-backups-kept-index: 2;
    callback backup-restore(int);
    in property <[string]> settings-check-labels;
    in-out property <int> settings-check-index: 3;
    in property <string> account-login;
    in property <string> account-initial;
    in property <image> account-avatar;
    in property <bool> account-busy;
    in property <string> account-error;
    in property <string> account-github-only;
    in property <string> account-device-code;
    in property <bool> device-login-offered;
    callback login();
    callback login-device();
    callback open-device-page();
    callback login-cancel();
    callback logout();
    callback settings-browse();
    callback settings-save();

    // Leaving Settings saves a field typed into without Enter.
    function open-page(page: int) {
        if root.page == 2 && page != 2 {
            root.settings-save();
        }
        root.page = page;
        // The control under a tooltip may be gone with the page.
        TipState.text = "";
    }

    // Confirmation dialog
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-danger;
    // A third button between Cancel and OK (for example "Scan locally"); hidden when empty.
    in property <string> confirm-extra;
    // Only an OK button: the dialog shows a result and has nothing to cancel.
    in property <bool> confirm-info;
    callback confirm-accept();
    callback confirm-cancel();
    callback confirm-extra-accept();

    // Add-repo dialog
    in-out property <bool> repo-open;
    in-out property <string> repo-input;
    in property <string> repo-error;
    in property <bool> repo-busy;
    callback repo-submit();
    callback repo-cancel();

    // Self-update banner, empty version = hidden
    in property <string> self-update-version;
    in property <bool> self-update-busy;
    // Later was clicked: the banner waits for the next start.
    property <bool> self-update-later;
    // False for a bare Linux binary outside an AppImage: it can't replace itself.
    in property <bool> self-update-in-place: true;
    callback self-update();

    // Keys no control takes come here: Escape closes what is on top (the picture, a dialog, the
    // details). It holds the focus at start, so Escape works before anything was tabbed to.
    keys := FocusScope {
        width: parent.width;
        height: parent.height;
        init => { self.focus(); }
        key-pressed(event) => {
            // Desktop habits: F5 checks for updates, Ctrl+F goes to the search of a list.
            if (event.text == Key.F5 && root.keys-free) {
                root.check-updates();
                return accept;
            }
            // Ctrl+1, 2, 3 open Installed, Browse, Settings; Ctrl+U updates all.
            if (event.modifiers.control && (event.text == "1" || event.text == "2" || event.text == "3") && root.keys-free) {
                root.open-page(event.text == "1" ? 0 : event.text == "2" ? 1 : 2);
                return accept;
            }
            if (event.modifiers.control && (event.text == "u" || event.text == "U") && root.keys-free) {
                if (root.update-count > 0 && !root.addons-busy) {
                    root.update-all();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F") && root.keys-free && root.page != 2 && !root.showing-detail) {
                root.search-focus += 1;
                return accept;
            }
            // The shoulder buttons of a controller come as Page Up and Page Down.
            if ((event.text == Key.PageDown || event.text == Key.PageUp) && !root.needs-setup && !root.zoom-open && !root.confirm-open && !root.repo-open && !root.results-open) {
                root.open-page(mod(root.page + (event.text == Key.PageDown ? 1 : 2), 3));
                return accept;
            }
            if (event.text != Key.Escape) {
                return reject;
            }
            if (root.zoom-open) {
                root.zoom-open = false;
            } else if (root.confirm-open) {
                if (root.confirm-info) {
                    root.confirm-accept();
                } else {
                    root.confirm-cancel();
                }
            } else if (root.results-open) {
                root.update-results-close();
            } else if (root.repo-open) {
                if (!root.repo-busy) {
                    root.repo-cancel();
                }
            } else if (root.comments-compose-open) {
                if (!root.comments-sending) {
                    root.comments-cancel-reply();
                }
            } else if (root.showing-detail) {
                root.detail-page = -1;
            } else if (root.page != 2 && root.search != "") {
                root.search = "";
                root.search-changed("");
            } else {
                return reject;
            }
            accept
        }

        Rectangle {
            background: Theme.bg-glow;
        }

        if root.needs-setup : SetupView {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            path <=> root.setup-path;
            error <=> root.setup-error;
            warning <=> root.setup-warning;
            example: root.addons-example;
            suggestions: root.setup-suggestions;
            searching: root.setup-searching;
            file-dialog: root.file-dialog;
            game-mode: root.game-mode;
            browse => { root.setup-browse(); }
            pick(path) => { root.setup-path = path; root.setup-confirm(); }
            confirm => { root.setup-confirm(); }
            quit => { root.close-window(); }
        }

        if !root.needs-setup : VerticalLayout {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            padding-left: 28px;
            padding-right: 28px;
            padding-bottom: 8px;
            spacing: 14px;

            // The logo in the middle, the game's start button on the right, apart from the tabs.
            Rectangle {
                height: max(logo.preferred-height, launch.preferred-height);
                logo := Text {
                    text: "SurvivorsForge";
                    font-family: Theme.font-display;
                    font-size: Theme.logo;
                    color: Theme.gold-heading;
                    horizontal-alignment: center;
                }
                launch := VerticalLayout {
                    x: parent.width - self.width;
                    // Wider than the label for more room around it; the hint wraps to the same width.
                    width: 220px;
                    alignment: center;
                    spacing: 4px;
                    ActionButton {
                        text: root.game-running ? "Game running" : root.game-updating ? (root.game-step != "" ? root.game-step : "Updating the game...") : root.game-update != "" ? root.game-update : root.addons-busy ? "Installing addons..." : "Launch game";
                        primary: true;
                        large: true;
                        busy: root.game-updating;
                        // Off at once on the click, before the game's window shows up.
                        enabled: (root.game-missing == "" || root.game-update != "") && !root.game-running && !root.game-updating
                            && !(root.addons-busy && root.game-update == "");
                        clicked => {
                            if root.game-update != "" {
                                root.update-game();
                            } else {
                                root.launch-game();
                            }
                        }
                    }
                    // One slot for the bar while the game updates and the link before: the header keeps its height.
                    if root.game-updating || root.game-update != "" || root.game-hint != "" : Rectangle {
                        height: Theme.touch ? 44px : 22px;
                        if root.game-updating : ProgressBar {
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            value: root.game-progress;
                        }
                        if !root.game-updating && root.game-update != "" && root.game-missing == "" && !root.game-running && !root.addons-busy : LinkButton {
                            width: parent.width;
                            height: parent.height;
                            text: "Start without updating";
                            clicked => { root.launch-game(); }
                        }
                    }
                    if root.game-hint != "" : Text {
                        text: root.game-hint;
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.game-missing != "" : Text {
                        text: root.game-missing;
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.game-missing != "" && root.page != 2 : HorizontalLayout {
                        alignment: center;
                        LinkButton {
                            text: "Open Settings";
                            clicked => { root.open-page(2); }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                TabButton {
                    text: "Installed (" + root.installed-total + ")";
                    active: root.page == 0;
                    clicked => { root.open-page(0); }
                }
                TabButton {
                    text: "Browse";
                    active: root.page == 1;
                    clicked => { root.open-page(1); }
                }
                TabButton {
                    text: "Settings";
                    active: root.page == 2;
                    clicked => { root.open-page(2); }
                }
                // Game Mode has no title bar, so give it its own way out.
                if root.game-mode : TabButton {
                    text: "Quit";
                    clicked => { root.close-window(); }
                }
            }

            // Gold on dark, not the crimson of Launch game; Later hides it until the next start.
            if root.self-update-version != "" && !root.self-update-later : Rectangle {
                height: Theme.touch ? 60px : 48px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.gold;
                background: Theme.control;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    spacing: 16px;
                    Text {
                        text: "SurvivorsForge " + root.self-update-version + " is available.";
                        font-size: Theme.body;
                        color: Theme.gold-bright;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        ActionButton {
                            text: root.self-update-busy ? "Updating..." : root.self-update-in-place ? "Update and restart" : "Open download page";
                            enabled: !root.self-update-busy;
                            clicked => { root.self-update(); }
                        }
                    }
                    if !root.self-update-busy : VerticalLayout {
                        alignment: center;
                        LinkButton {
                            text: "Later";
                            clicked => { root.self-update-later = true; }
                        }
                    }
                }
            }

            Panel {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    if root.page != 2 && !root.showing-detail : HorizontalLayout {
                        spacing: Theme.gap-tight;
                        Field {
                            horizontal-stretch: 1;
                            placeholder: "Search name or author";
                            label: "Search addons";
                            clearable: true;
                            clear-label: "Clear search";
                            focus-request: root.search-focus;
                            text <=> root.search;
                            edited(text) => { root.search-changed(text); }
                        }
                        // Icons named by their tooltips, as tall as the search field.
                        if root.page == 0 : GlyphButton {
                            height: Theme.touch ? 44px : 38px;
                            label: root.checking ? "Checking for updates..." : "Check for updates";
                            // Two arrows around a circle.
                            glyph: "M 13.5 8 A 5.5 5.5 0 1 1 11.6 3.8 M 12.2 1 L 12 4.2 L 8.8 4";
                            enabled: !root.checking;
                            clicked => { root.check-updates(); }
                        }
                        if root.page == 0 && root.file-dialog : GlyphButton {
                            height: Theme.touch ? 44px : 38px;
                            label: "Install zip";
                            // An archive box with its lid and handle.
                            glyph: "M 2.5 6 L 13.5 6 L 13.5 14 L 2.5 14 Z M 1.5 2.5 L 14.5 2.5 L 14.5 6 L 1.5 6 Z M 6 9 L 10 9";
                            clicked => { root.install-zip(); }
                        }
                        if root.page == 0 : GlyphButton {
                            height: Theme.touch ? 44px : 38px;
                            label: "Add GitHub repo";
                            // A plus.
                            glyph: "M 8 2.5 L 8 13.5 M 2.5 8 L 13.5 8";
                            clicked => { root.add-repo(); }
                        }
                        if root.page == 0 && Theme.touch && root.update-count > 0 : ActionButton {
                            text: "Update all (" + root.update-count + ")";
                            primary: true;
                            clicked => { root.update-all(); }
                        }
                        if root.page == 0 && !(Theme.touch && root.update-count > 0) : GlyphButton {
                            height: Theme.touch ? 44px : 38px;
                            label: root.update-count > 0 ? "Update all (" + root.update-count + ")" : root.checking ? "Update all" : "All up to date";
                            // An arrow into a tray, or a tick when there is nothing to update.
                            glyph: root.update-count > 0 || root.checking ? "M 8 2 L 8 10.5 M 4.5 7 L 8 10.5 L 11.5 7 M 2.5 13.5 L 13.5 13.5" : "M 3 8.5 L 6.5 12 L 13 4.5";
                            badge: root.update-count > 0 ? root.update-count : "";
                            primary: root.update-count > 0;
                            enabled: root.update-count > 0;
                            clicked => { root.update-all(); }
                        }
                    }

                    // Filters and order as on the website, for both lists; GitHub and zip addons have no
                    // category or safety check, so a chosen one hides them. Tiles or rows at the right end.
                    if root.page != 2 && !root.showing-detail : HorizontalLayout {
                        spacing: Theme.gap-tight;
                        Dropdown {
                            width: 220px;
                            label: "Category";
                            model: root.category-labels;
                            list-labels: root.category-list-labels;
                            levels: root.category-levels;
                            current-index <=> root.category-index;
                            selected => { root.category-changed(self.current-index); }
                        }
                        Dropdown {
                            width: 190px;
                            label: "Safety check";
                            model: root.safety-labels;
                            current-index <=> root.safety-index;
                            selected => { root.safety-changed(self.current-index); }
                        }
                        Dropdown {
                            width: 190px;
                            label: "Sort by";
                            model: root.sort-labels;
                            current-index <=> root.sort-index;
                            selected => { root.sort-changed(self.current-index); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.page == 0 : ViewToggle {
                            tiles <=> root.installed-tiles;
                            changed(on) => { root.view-changed(0, on); }
                        }
                        if root.page == 1 : ViewToggle {
                            tiles <=> root.browse-tiles;
                            changed(on) => { root.view-changed(1, on); }
                        }
                    }

                    if root.showing-detail : DetailView {
                        // The Overview fills the page; another tab's list does under the header.
                        vertical-stretch: root.detail-tab <= 1 ? 1 : 0;
                        detail: root.detail;
                        tab <=> root.detail-tab;
                        tab-changed(tab) => { root.detail-tab-changed(tab); }
                        links-enabled: !root.game-mode;
                        back => { root.detail-page = -1; }
                        action => { root.row-action(root.detail.row.id); }
                        remove => { root.row-remove(root.detail.row.id); }
                        open => { root.row-open(root.detail.row.id); }
                        website => { root.detail-website(); }
                        link(page) => { root.detail-link(page); }
                        scan => { root.detail-scan(); }
                        auto-update => { root.detail-auto-update(); }
                        enlarge-shot(i) => {
                            root.zoom-shots = root.detail.shots;
                            root.zoom-index = i;
                            root.zoom-open = true;
                        }
                        enlarge(image, caption) => {
                            root.zoom-shots = [{ image: image, caption: caption }];
                            root.zoom-index = 0;
                            root.zoom-open = true;
                        }
                    }

                    if root.showing-detail && root.detail-tab == 2 : IssuesView {
                        vertical-stretch: 1;
                        rows: root.issues-rows;
                        open-count: root.issues-open;
                        loading: root.issues-loading;
                        failed: root.issues-failed;
                        links-enabled: !root.game-mode;
                        logged-in: root.account-login != "";
                        writable: root.detail.issues-ready;
                        mode: root.issues-mode;
                        new-kind <=> root.issues-new-kind;
                        new-title <=> root.issues-new-title;
                        new-body <=> root.issues-new-body;
                        sending: root.issues-sending;
                        send-error: root.issues-send-error;
                        needs-login: root.issues-needs-login;
                        issue-number: root.issue-number;
                        issue-title: root.issue-title;
                        issue-meta: root.issue-meta;
                        issue-body: root.issue-body;
                        issue-closed: root.issue-closed;
                        issue-locked: root.issue-locked;
                        replies: root.issue-replies;
                        issue-loading: root.issue-loading;
                        issue-failed: root.issue-failed;
                        reply-draft <=> root.issue-reply-draft;
                        show(number) => { root.issue-show(number); }
                        back => { root.issues-back(); }
                        new-issue => { root.issues-new(); }
                        submit => { root.issues-submit(); }
                        send-reply => { root.issue-send-reply(); }
                        login => { root.login(); }
                        open(number) => { root.detail-link(number == 0 ? "issues" : "issues/" + number); }
                        report => { root.detail-link("bug"); }
                        retry => { root.detail-retry(2); }
                    }

                    if root.showing-detail && root.detail-tab == 3 : CommentsView {
                        vertical-stretch: 1;
                        embedded: true;
                        name: root.detail.row.name;
                        rows: root.comments-rows;
                        waiting: root.comments-waiting;
                        failed: root.comments-failed;
                        off: root.comments-off;
                        more: root.comments-more;
                        loading-more: root.comments-loading-more;
                        links-enabled: !root.game-mode;
                        logged-in: root.account-login != "";
                        login => { root.login(); }
                        compose => { root.comments-compose(); }
                        reply(id) => { root.comments-reply(id); }
                        write => { root.detail-link("comments"); }
                        older => { root.comments-older(); }
                        retry => { root.comments-retry(); }
                    }

                    if root.showing-detail && root.detail-tab == 4 : VersionsView {
                        vertical-stretch: 1;
                        rows: root.versions-rows;
                        loading: root.versions-loading;
                        failed: root.versions-failed;
                        busy: root.detail.row.busy;
                        retry => { root.detail-retry(4); }
                        install(tag) => { root.version-install(tag); }
                        links-enabled: !root.game-mode;
                        notes(tag) => { root.detail-link("release/" + tag); }
                    }

                    // Stays while the server is away, unlike the toast that said so.
                    if root.offline && root.page != 2 && !root.showing-detail : HorizontalLayout {
                        spacing: Theme.gap-tight;
                        Text {
                            horizontal-stretch: 1;
                            text: "Offline: the SurvivorsForge server cannot be reached. Lists may be old and safety checks too; updates come straight from GitHub.";
                            font-size: Theme.meta;
                            color: Theme.warn;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        LinkButton {
                            text: "Try again";
                            clicked => { root.check-updates(); }
                        }
                    }

                    if root.page == 0 && !root.showing-detail : ScrollPanel {
                        vertical-stretch: 1;
                        // Back from the details lands where the list was left.
                        scroll-y <=> root.installed-scroll;
                        if root.installed-tiles : AddonTiles {
                            rows: root.installed-rows;
                            action(id) => { root.row-action(id); }
                            remove(id) => { root.row-remove(id); }
                            toggle(id) => { root.row-toggle(id); }
                            open(id) => { root.row-open(id); }
                            details(id) => { root.row-details(id); }
                        }
                        if !root.installed-tiles : VerticalLayout {
                            spacing: 6px;
                            for row in root.installed-rows : AddonRowView {
                                addon: row;
                                action => { root.row-action(row.id); }
                                remove => { root.row-remove(row.id); }
                                toggle => { root.row-toggle(row.id); }
                                open => { root.row-open(row.id); }
                                details => { root.row-details(row.id); }
                            }
                        }
                        if root.installed-rows.length == 0 : Text {
                            // The filters are shared with Browse, so they can hide everything here too.
                            text: root.filtered ? "No installed addon matches the search and filters."
                                : root.file-dialog ? "No addons installed yet. Browse the verified addons, install a zip or add a GitHub repo."
                                : "No addons installed yet. Browse the verified addons or add a GitHub repo.";
                            font-size: Theme.body;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        if root.installed-rows.length == 0 && root.filtered : HorizontalLayout {
                            alignment: center;
                            LinkButton {
                                text: "Clear search and filters";
                                clicked => { root.clear-filters(); }
                            }
                        }
                        Rectangle { height: root.toast-room; }
                    }

                    // One zip with every picked addon, for the browser version of the game.
                    if root.page == 1 && !root.showing-detail && root.picked-count > 0 : HorizontalLayout {
                        spacing: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: (root.picked-count == 1 ? "1 addon picked" : root.picked-count + " addons picked")
                                + ": one zip with all of them, for the browser version of the game";
                            font-size: Theme.body;
                            color: Theme.gold;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            text: root.pack-busy ? "Packing..." : "Save as zip";
                            primary: true;
                            enabled: !root.pack-busy;
                            clicked => { root.pack-save(); }
                        }
                        ActionButton {
                            text: "Share as link";
                            enabled: !root.pack-busy && !root.game-mode;
                            clicked => { root.pack-share(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            LinkButton {
                                text: "Clear";
                                clicked => { root.pack-clear(); }
                            }
                        }
                    }

                    if root.page == 1 && !root.showing-detail : ScrollPanel {
                        vertical-stretch: 1;
                        scroll-y <=> root.browse-scroll;
                        if root.browse-tiles : AddonTiles {
                            rows: root.browse-rows;
                            action(id) => { root.row-action(id); }
                            remove(id) => { root.row-remove(id); }
                            toggle(id) => { root.row-toggle(id); }
                            open(id) => { root.row-open(id); }
                            details(id) => { root.row-details(id); }
                            pick(id) => { root.row-pick(id); }
                        }
                        if !root.browse-tiles : VerticalLayout {
                            spacing: 6px;
                            for row in root.browse-rows : AddonRowView {
                                addon: row;
                                action => { root.row-action(row.id); }
                                remove => { root.row-remove(row.id); }
                                toggle => { root.row-toggle(row.id); }
                                open => { root.row-open(row.id); }
                                details => { root.row-details(row.id); }
                                pick => { root.row-pick(row.id); }
                            }
                        }
                        if root.browse-rows.length == 0 : Text {
                            text: root.search != "" ? "No addon matches \"" + root.search + "\"." : "No addon in this category with this safety check.";
                            font-size: Theme.body;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        if root.browse-rows.length == 0 && root.filtered : HorizontalLayout {
                            alignment: center;
                            LinkButton {
                                text: "Clear search and filters";
                                clicked => { root.clear-filters(); }
                            }
                        }
                        Rectangle { height: root.toast-room; }
                    }

                    // The page is longer than the smallest window: it scrolls.
                    if root.page == 2 : ScrollPanel {
                        vertical-stretch: 1;
                        SettingsView {
                            path <=> root.settings-path;
                            game-versions: root.settings-game-versions;
                            checking: root.checking;
                            game-versions-failed: root.settings-game-versions-failed;
                            game-index <=> root.settings-game-index;
                            api-url <=> root.settings-api-url;
                            path-error: root.settings-path-error;
                            api-error: root.settings-api-error;
                            web-error: root.settings-web-error;
                            web-url <=> root.settings-web-url;
                            api-default: root.settings-api-default;
                            web-default: root.settings-web-default;
                            telemetry <=> root.settings-telemetry;
                            send-install-id <=> root.settings-send-install-id;
                            auto-update <=> root.settings-auto-update;
                            after-launch-labels: root.settings-after-launch-labels;
                            after-launch-index <=> root.settings-after-launch-index;
                            periodic-check <=> root.settings-periodic-check;
                            update-disabled <=> root.settings-update-disabled;
                            check-labels: root.settings-check-labels;
                            check-index <=> root.settings-check-index;
                            backups: root.settings-backups;
                            backups-total: root.settings-backups-total;
                            backups-all <=> root.settings-backups-all;
                            backups-toggled => { root.backups-toggled(); }
                            profiles: root.settings-profiles;
                            profile-name <=> root.settings-profile-name;
                            profile-error: root.settings-profile-error;
                            profile-save => { root.profile-save(); }
                            profile-apply(index) => { root.profile-apply(index); }
                            profile-delete(index) => { root.profile-delete(index); }
                            profile-copy(index) => {
                                clipboard.text = root.profile-string(index);
                                clipboard.select-all();
                                clipboard.copy();
                                clipboard.clear-selection();
                                clipboard.text = "";
                                root.profile-copied();
                            }
                            profile-import-text <=> root.settings-profile-import;
                            sync-profiles <=> root.settings-sync-profiles;
                            profile-import(text) => { root.profile-import(text); }
                            backups-kept-labels: root.settings-backups-kept-labels;
                            backups-kept-index <=> root.settings-backups-kept-index;
                            backup-restore(index) => { root.backup-restore(index); }
                            account-login: root.account-login;
                            account-initial: root.account-initial;
                            account-avatar: root.account-avatar;
                            account-busy: root.account-busy;
                            account-error: root.account-error;
                            account-github-only: root.account-github-only;
                            account-device-code: root.account-device-code;
                            device-login-offered: root.device-login-offered;
                            offline: root.offline;
                            login-device => { root.login-device(); }
                            open-device-page => { root.open-device-page(); }
                            login => { root.login(); }
                            login-cancel => { root.login-cancel(); }
                            logout => { root.logout(); }
                            version: root.app-version;
                            file-dialog: root.file-dialog;
                            game-mode: root.game-mode;
                            browse => { root.settings-browse(); }
                            save => { root.settings-save(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: Theme.touch ? 44px : 22px;
                spacing: 16px;
                Text {
                    text: "AddOns: " + root.addons-dir;
                    font-size: Theme.meta;
                    vertical-alignment: center;
                    color: Theme.text-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // Game Mode has no file manager to show it in.
                if !root.game-mode && root.addons-dir != "" : LinkButton {
                    text: "Open folder";
                    clicked => { root.open-addons-dir(); }
                }
                Text {
                    text: "v" + root.app-version;
                    font-size: 11px;
                    vertical-alignment: center;
                    color: Theme.text-muted;
                }
            }
        }

        // Above the pages and the bottom line, under the dialogs.
        toast-stack := ToastStack {
            x: parent.width - self.width - 24px;
            y: parent.height - self.height - 40px;
            width: 380px;
            height: self.preferred-height;
            toasts: root.toasts;
            busy-closable: false;
            errors-copyable: true;
            style: {
                background: Theme.panel,
                border: Theme.outline,
                text: Theme.text,
                muted: Theme.text-muted,
                info: Theme.info,
                success: Theme.ok,
                warning: Theme.warn,
                error: Theme.danger,
                busy: Theme.gold,
                font-size: Theme.body,
                radius: 4px,
                close-size: Theme.touch ? 44px : 26px,
            };
            dismiss(id) => { root.toast-dismiss(id); }
            action(id) => { root.toast-action(id); }
        }

        if root.repo-open : Overlay {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            DialogCard {
                title: "Add GitHub Repo";
                Text {
                    text: "SurvivorsForge checks the latest release, then the newest tag, then the default branch for an addon.";
                    font-size: Theme.body;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Field {
                    text <=> root.repo-input;
                    placeholder: "owner/repo or https://github.com/owner/repo";
                    label: "GitHub repo";
                    enabled: !root.repo-busy;
                    init => { self.focus-input(); }
                    accepted => { root.repo-submit(); }
                }
                if root.repo-error != "" : Text {
                    text: root.repo-error;
                    font-size: Theme.body;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.gap-tight;
                    ActionButton {
                        text: "Cancel";
                        enabled: !root.repo-busy;
                        clicked => { root.repo-cancel(); }
                    }
                    ActionButton {
                        text: root.repo-busy ? "Checking..." : "Check repo";
                        primary: true;
                        enabled: !root.repo-busy && root.repo-input != "";
                        clicked => { root.repo-submit(); }
                    }
                }
            }
        }

        if root.comments-compose-open : Overlay {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            DialogCard {
                width: 640px;
                title: root.comments-reply-to != "" ? "Reply to " + root.comments-reply-to : "New comment";
                TextArea {
                    text <=> root.comments-draft;
                    placeholder: root.comments-reply-to != "" ? "Your reply" : "Your comment";
                    label: root.comments-reply-to != "" ? "Your reply" : "Your comment";
                    enabled: !root.comments-sending;
                    init => { self.focus-input(); }
                    submitted => { if (!root.comments-sending) { root.comments-send(); } }
                }
                if root.comments-send-error != "" : Text {
                    text: "Error: " + root.comments-send-error;
                    font-size: Theme.meta;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.gap-tight;
                    Text {
                        text: "Ctrl+Enter sends. Edit or delete it later on the website.";
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.comments-needs-login : ActionButton {
                        text: "Log in again";
                        enabled: !root.game-mode;
                        clicked => { root.login(); }
                    }
                    ActionButton {
                        text: "Cancel";
                        enabled: !root.comments-sending;
                        clicked => { root.comments-cancel-reply(); }
                    }
                    ActionButton {
                        text: root.comments-sending ? "Sending" : root.comments-reply-to != "" ? "Send reply" : "Send";
                        primary: true;
                        enabled: !root.comments-sending && root.comments-draft != "";
                        clicked => { root.comments-send(); }
                    }
                }
            }
        }

        if root.zoom-open : PictureViewer {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            shots: root.zoom-shots;
            index <=> root.zoom-index;
            close => { root.zoom-open = false; }
        }

        if root.drop-hover : Rectangle {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            background: Theme.overlay;
            border-width: 2px;
            border-color: Theme.gold;
            Text {
                text: "Drop the zip to install it";
                font-size: 24px;
                color: Theme.gold-heading;
            }
        }

        if root.results-open : Overlay {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            UpdateResultsDialog {
                results: root.update-results;
                updated: root.update-results-updated;
                retryable: root.update-results-retryable;
                links-enabled: !root.game-mode;
                fix(id) => { root.update-result-fix(id); }
                notes(id) => { root.update-result-notes(id); }
                retry-failed => { root.update-results-retry(); }
                close => { root.update-results-close(); }
            }
        }

        if root.confirm-open : Overlay {
            y: root.title-height;
            width: parent.width;
            height: parent.height - root.title-height;
            DialogCard {
                title: root.confirm-title;
                Text {
                    text: root.confirm-text;
                    font-size: Theme.body;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.gap-tight;
                    if !root.confirm-info : ActionButton {
                        text: "Cancel";
                        // Return on a dangerous question keeps things as they are.
                        init => {
                            if (root.confirm-danger) {
                                self.focus-button();
                            }
                        }
                        clicked => { root.confirm-cancel(); }
                    }
                    if root.confirm-extra != "" : ActionButton {
                        text: root.confirm-extra;
                        clicked => { root.confirm-extra-accept(); }
                    }
                    ActionButton {
                        text: root.confirm-ok;
                        primary: !root.confirm-danger;
                        danger: root.confirm-danger;
                        init => {
                            if (!root.confirm-danger || root.confirm-info) {
                                self.focus-button();
                            }
                        }
                        clicked => { root.confirm-accept(); }
                    }
                }
            }
        }

        if !root.game-mode : TitleBar {
            x: 0;
            y: 0;
            width: parent.width;
            title: root.title;
            maximized: root.maximized;
            start-drag => { root.start-drag(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close => { root.close-window(); }
        }

        if !root.maximized && !root.game-mode : ResizeEdges {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            start-resize(direction) => { root.start-resize(direction); }
        }

        // Holds a text while it goes to the clipboard; never seen. Outside every scrolling page:
        // selecting text there scrolled the page to it.
        clipboard := TextInput {
            x: 0;
            y: 0;
            width: 0px;
            height: 0px;
            read-only: true;
            accessible-role: none;
        }

        // Last, so a tooltip shows above everything; it takes no input.
        TooltipLayer {
            width: parent.width;
            height: parent.height;
        }
    }
}
