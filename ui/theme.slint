// Matches the Azeroth Survivors menus: near-black warm ground, gold outlines and lettering,
// deep red for the selected or primary element, Morpheus display type for headings.
// Surfaces separate by thin gold-brown borders; no shadows.
import "fonts/Morpheus.ttf";
import "fonts/Marcellus-Regular.ttf";

export global Theme {
    out property <string> font-display: "Morpheus";
    out property <string> font-body: "Marcellus";

    // Ground and surfaces
    out property <color> bg: #0A0806;
    out property <brush> bg-glow: @radial-gradient(circle, #1A130C 0%, #0A0806 75%);
    out property <brush> panel: @linear-gradient(180deg, #14100B 0%, #0E0B08 100%);
    out property <color> field: #0C0907;
    out property <brush> row: @linear-gradient(90deg, #1B140D 0%, #120E09 100%);
    out property <brush> row-hover: @linear-gradient(90deg, #241A10 0%, #16110B 100%);
    out property <color> overlay: #000000C0;

    // Lines: decorative panel edges, then interactive outlines (>= 3:1 on the ground)
    out property <color> line: #3A2C18;
    out property <color> outline: #8A6C3A;
    out property <color> outline-hover: #C9A24E;
    out property <color> outline-active: #F0CC6A;

    // Lettering
    out property <color> gold: #E8C25A;
    out property <color> gold-bright: #F6DD9A;
    out property <brush> gold-heading: @linear-gradient(180deg, #FBE7A1 0%, #D9A93E 100%);
    out property <color> text: #E9DCC0;
    out property <color> text-muted: #A89679;
    out property <color> text-disabled: #6E6250;

    // Selected tab / primary action: deep red
    out property <brush> crimson: @linear-gradient(180deg, #5A1913 0%, #2B0907 100%);
    out property <brush> crimson-hover: @linear-gradient(180deg, #6E2018 0%, #36100B 100%);
    out property <brush> control: @linear-gradient(180deg, #17110B 0%, #0E0A07 100%);

    // Status, semantic only
    out property <color> ok: #5BE36F;
    out property <color> warn: #F0A030;
    out property <color> danger: #E0574A;

    out property <length> logo: 44px;
    out property <length> title: 30px;
    out property <length> heading: 21px;
    out property <length> body: 15px;
    out property <length> meta: 13px;

    // Steam Deck Game Mode: touch screen, so controls grow to at least 44px.
    in-out property <bool> touch;

    out property <length> gap-tight: 8px;
    out property <length> gap-loose: 24px;
    out property <length> radius: 3px;
}
