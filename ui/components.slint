import { Theme } from "theme.slint";

export struct AddonRow {
    id: string,
    name: string,
    initial: string,
    // The platform's icon; empty (width 0) without one, then the initial stands in.
    icon: image,
    author: string,
    version: string,
    badge: string,
    description: string,
    status: string,
    // 0 neutral, 1 ok, 2 update available, 3 error
    status-kind: int,
    // How full the bar of a running download is, 0 to 1; below 0 without a bar.
    progress: float,
    // Empty when the row offers no main action.
    action: string,
    busy: bool,
    can-remove: bool,
    can-open: bool,
    warning: string,
    // Browse only: the row can go into an addon pack, and is picked for one.
    can-pick: bool,
    picked: bool,
}

// A thin bar for a running download.
export component ProgressBar inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: Theme.line;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        height: parent.height;
        border-radius: 2px;
        background: Theme.gold;
    }
}

// One block of a description: 0 paragraph, 1 heading, 2 list item, 3 code, 4 quote, 5 image.
export struct AboutBlock {
    kind: int,
    marker: string,
    text: string,
    image: image,
}

export struct Shot {
    image: image,
    caption: string,
}

// An addon opened from a list: its row plus what the list has no room for.
export struct AddonDetail {
    row: AddonRow,
    category: string,
    safety: string,
    game: string,
    folders: string,
    needs: string,
    // The description in blocks, the summary while it loads or when there is none.
    about: [AboutBlock],
    // Screenshots in the website's order; an image stays empty while it loads.
    shots: [Shot],
    // Nothing stored yet and the platform is being asked: placeholders pulse below the summary.
    about-loading: bool,
    // The addon has a page on the platform website.
    on-website: bool,
    // An installed platform addon: it may update on its own.
    can-auto-update: bool,
    // It does: switched on for it, or for all addons in the settings.
    auto-update: bool,
    // Switched on for all addons in the settings; the box here cannot turn it off.
    auto-update-all: bool,
    // "Report a bug" (the platform's form) or "Report on GitHub", as on the website.
    bug-label: string,
    // The platform takes bug reports: its Issues tab is worth a button.
    issues-ready: bool,
    // The owner turned the Comments tab on.
    comments-on: bool,
}

// An open issue on the detail view's Issues tab.
export struct IssueLine {
    number: int,
    title: string,
    author: string,
    comments: int,
    date: string,
}

// A version on the detail view's Versions tab.
export struct VersionLine {
    tag: string,
    name: string,
    date: string,
    // The platform's trust label ("Checked", "Flagged") and its colour: 1 ok, 2 warn, 3 danger.
    trust: string,
    trust-kind: int,
    downloads: int,
    prerelease: bool,
}

// One comment of an addon's discussion, in reading order; `depth` indents replies (0 to 3).
export struct CommentRow {
    author: string,
    avatar: image,
    initial: string,
    date: string,
    edited: bool,
    deleted: bool,
    depth: int,
    body: string,
}

// Outlined gold button; `primary` is the deep red one with the gold rim.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    // Display type and more height, for the one call to action of a screen.
    in property <bool> large;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    height: root.large ? 46px : Theme.touch ? 44px : 34px;
    min-width: label.preferred-width + (root.large ? 40px : 28px);
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.outline-active
        : !root.enabled ? Theme.line
        : root.danger && touch.has-hover ? Theme.danger
        : root.primary ? (touch.has-hover ? Theme.outline-active : Theme.outline-hover)
        : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: !root.enabled ? Theme.control
        : root.primary ? (touch.has-hover && !touch.pressed ? Theme.crimson-hover : Theme.crimson)
        : Theme.control;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: root.large ? Theme.font-display : Theme.font-body;
        font-size: root.large ? 19px : Theme.body;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        color: !root.enabled ? Theme.text-disabled
            : root.danger ? Theme.danger
            : root.primary ? Theme.gold-bright : Theme.gold;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    // Tab reaches the button, Space or Return presses it.
    focus := FocusScope {
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// The tooltip showing now, and where its control is in the window. One for the whole window:
// TooltipLayer draws it above everything, so no panel or list below clips or covers it.
export global TipState {
    in-out property <string> text;
    // The control's bottom centre, and its top for a tip that does not fit below.
    in-out property <length> x;
    in-out property <length> bottom;
    in-out property <length> top;
}

// A TouchArea that names its control after a short hover, and hides the name on leave and press.
export component TipArea inherits TouchArea {
    in property <string> tip;

    Timer {
        interval: 450ms;
        running: root.has-hover && root.tip != "" && TipState.text != root.tip;
        triggered => {
            TipState.x = root.absolute-position.x + root.width / 2;
            TipState.bottom = root.absolute-position.y + root.height;
            TipState.top = root.absolute-position.y;
            TipState.text = root.tip;
        }
    }
    changed has-hover => {
        if !self.has-hover && TipState.text == root.tip {
            TipState.text = "";
        }
    }
    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            TipState.text = "";
        }
    }
}

// Draws TipState's tooltip; place it last in the window, over the whole window. It takes no input.
export component TooltipLayer inherits Rectangle {
    if TipState.text != "" : Rectangle {
        property <bool> fits-below: TipState.bottom + 6px + self.height <= root.height;
        accessible-role: text;
        accessible-label: TipState.text;
        x: clamp(TipState.x - self.width / 2, 4px, root.width - self.width - 4px);
        y: self.fits-below ? TipState.bottom + 6px : TipState.top - self.height - 6px;
        width: label.preferred-width + 18px;
        height: label.preferred-height + 10px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.outline;
        background: Theme.panel;
        drop-shadow-blur: 8px;
        drop-shadow-color: #000000A0;
        label := Text {
            text: TipState.text;
            font-size: Theme.meta;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Square outlined button with a drawn glyph (16x16 path), for icon-only actions. Its label shows
// as a tooltip on hover.
export component GlyphButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    // Red on hover (remove), or the deep red of a closing action (the viewer's X).
    in property <bool> danger;
    in property <bool> primary;
    // Off: dimmed and not pressable; the tooltip still names it.
    in property <bool> enabled: true;
    // A small count in the top right corner ("3" updates); empty for none.
    in property <string> badge;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    width: root.height;
    height: Theme.touch ? 44px : 34px;
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.outline-active
        : !root.enabled ? Theme.line
        : root.danger && touch.has-hover ? Theme.danger
        : root.primary ? (touch.has-hover ? Theme.outline-active : Theme.outline-hover)
        : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: root.primary && root.enabled ? (touch.has-hover ? Theme.crimson-hover : Theme.crimson) : Theme.control;

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.glyph;
        stroke: !root.enabled ? Theme.text-disabled
            : root.danger && touch.has-hover ? Theme.danger
            : root.primary || touch.has-hover ? Theme.gold-bright : Theme.text-muted;
        stroke-width: 1.5px;
    }

    if root.badge != "" : Rectangle {
        x: parent.width - self.width + 5px;
        y: -5px;
        width: max(16px, count.preferred-width + 8px);
        height: 16px;
        border-radius: 8px;
        background: Theme.gold;
        count := Text {
            text: root.badge;
            font-size: 11px;
            color: #1A1208;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TipArea {
        width: parent.width;
        height: parent.height;
        tip: root.label;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }

    // Tab reaches the button, Space or Return presses it.
    focus := FocusScope {
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// Square button with a bin, for removing an addon; turns red on hover.
export component RemoveButton inherits GlyphButton {
    label: "Remove";
    danger: true;
    // Lid with its handle, the bin, two ribs.
    glyph: "M 2 4 L 14 4 M 6 4 L 6 2 L 10 2 L 10 4 M 3.5 4 L 4.5 14 L 11.5 14 L 12.5 4 M 6.5 7 L 6.5 11 M 9.5 7 L 9.5 11";
}

// Screenshots shown large over the window, as on the website: the wheel, the buttons, + and - or a
// double click zoom around the pointer, dragging moves a zoomed picture, the arrows step through,
// a click beside the picture, the X or Escape closes.
export component PictureViewer inherits Rectangle {
    in property <[Shot]> shots;
    in-out property <int> index;
    callback close();

    property <Shot> shot: root.shots[root.index];
    property <float> scale: 1;
    property <length> pan-x;
    property <length> pan-y;
    // The picture fitted into the stage at scale 1.
    property <float> ratio: root.shot.image.width > 0 ? root.shot.image.height / root.shot.image.width : 0.5625;
    property <length> fit-width: min(stage.width - 48px, (stage.height - 48px) / root.ratio);
    property <length> shown-width: root.fit-width * root.scale;
    property <length> shown-height: root.shown-width * root.ratio;
    property <length> left: (stage.width - root.shown-width) / 2 + root.pan-x;
    property <length> top: (stage.height - root.shown-height) / 2 + root.pan-y;
    property <length> drag-x;
    property <length> drag-y;

    function step(by: int) {
        root.index = mod(root.index + by + root.shots.length, root.shots.length);
        root.zoom-at(1 / root.scale, stage.width / 2, stage.height / 2);
    }
    // Zooms by `factor` keeping the point (x, y) of the stage where it is.
    function zoom-at(factor: float, x: length, y: length) {
        let scale = min(6, max(1, root.scale * factor));
        let dx = x - stage.width / 2;
        let dy = y - stage.height / 2;
        root.pan-x = scale == 1 ? 0 : dx - (dx - root.pan-x) * scale / root.scale;
        root.pan-y = scale == 1 ? 0 : dy - (dy - root.pan-y) * scale / root.scale;
        root.scale = scale;
    }

    background: #050403F2;

    stage := Rectangle {
        width: parent.width;
        height: parent.height - bar.height;
        clip: true;
        Image {
            x: root.left;
            y: root.top;
            width: root.shown-width;
            height: root.shown-height;
            source: root.shot.image;
            image-fit: fill;
        }
        TouchArea {
            mouse-cursor: root.scale > 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.drag-x = root.pan-x;
                    root.drag-y = root.pan-y;
                }
            }
            moved => {
                if (root.scale > 1) {
                    root.pan-x = root.drag-x + self.mouse-x - self.pressed-x;
                    root.pan-y = root.drag-y + self.mouse-y - self.pressed-y;
                }
            }
            clicked => {
                let inside = self.mouse-x >= root.left && self.mouse-x <= root.left + root.shown-width
                    && self.mouse-y >= root.top && self.mouse-y <= root.top + root.shown-height;
                if (!inside) {
                    root.close();
                }
            }
            double-clicked => { root.zoom-at(root.scale > 1 ? 1 / root.scale : 2.5, self.mouse-x, self.mouse-y); }
            scroll-event(event) => {
                root.zoom-at(event.delta-y > 0 ? 1.2 : 1 / 1.2, self.mouse-x, self.mouse-y);
                accept
            }
        }
    }

    bar := Rectangle {
        y: parent.height - self.height;
        height: Theme.touch ? 64px : 54px;
        background: Theme.bg;
        Rectangle {
            y: 0;
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            alignment: stretch;
            Text {
                horizontal-stretch: 1;
                text: root.shot.caption;
                font-size: Theme.body;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.shots.length > 1 : Text {
                text: (root.index + 1) + " / " + root.shots.length;
                font-size: Theme.body;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            if root.shots.length > 1 : VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Previous screenshot";
                    glyph: "M 10 3 L 5 8 L 10 13";
                    clicked => { root.step(-1); }
                }
            }
            if root.shots.length > 1 : VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Next screenshot";
                    glyph: "M 6 3 L 11 8 L 6 13";
                    clicked => { root.step(1); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Zoom out";
                    glyph: "M 3 8 L 13 8";
                    clicked => { root.zoom-at(1 / 1.5, stage.width / 2, stage.height / 2); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Zoom in";
                    glyph: "M 3 8 L 13 8 M 8 3 L 8 13";
                    clicked => { root.zoom-at(1.5, stage.width / 2, stage.height / 2); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Fit to the window";
                    glyph: "M 2 6 L 2 2 L 6 2 M 10 2 L 14 2 L 14 6 M 14 10 L 14 14 L 10 14 M 6 14 L 2 14 L 2 10";
                    clicked => { root.zoom-at(1 / root.scale, stage.width / 2, stage.height / 2); }
                }
            }
            VerticalLayout {
                alignment: center;
                GlyphButton {
                    label: "Close";
                    glyph: "M 3 3 L 13 13 M 13 3 L 3 13";
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }

    keys := FocusScope {
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
            } else if (event.text == Key.RightArrow) {
                root.step(1);
            } else if (event.text == Key.LeftArrow) {
                root.step(-1);
            } else if (event.text == "+" || event.text == "=") {
                root.zoom-at(1.5, stage.width / 2, stage.height / 2);
            } else if (event.text == "-") {
                root.zoom-at(1 / 1.5, stage.width / 2, stage.height / 2);
            } else if (event.text == "0") {
                root.zoom-at(1 / root.scale, stage.width / 2, stage.height / 2);
            } else {
                return reject;
            }
            accept
        }
    }
}

// Small text-only control for secondary row actions (open, remove).
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    height: Theme.touch ? 44px : 22px;
    min-width: label.preferred-width + (Theme.touch ? 20px : 10px);

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.touch ? Theme.body : Theme.meta;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !touch.has-hover ? Theme.text-muted : root.danger ? Theme.danger : Theme.gold;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Top-level page tab, like the game's menu tabs. The selected one turns deep red.
export component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    accessible-role: tab;
    accessible-label: root.text;
    height: Theme.touch ? 44px : 40px;
    min-width: label.preferred-width + 36px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.active ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: root.active ? Theme.crimson : touch.has-hover ? Theme.control : Theme.bg;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 17px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.active ? Theme.gold-bright : Theme.gold;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Morpheus heading between two gold rules that fade out, like "Class" and "Zone" in the game.
export component SectionHeading inherits HorizontalLayout {
    in property <string> text;
    in property <length> size: Theme.title;
    spacing: 16px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, #00000000 0%, Theme.outline 100%);
        }
    }
    Text {
        text: root.text;
        font-family: Theme.font-display;
        font-size: root.size;
        color: Theme.gold-heading;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg, Theme.outline 0%, #00000000 100%);
        }
    }
}

// Single-line text input with the game's gold-rimmed field look.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback accepted();
    callback edited(string);
    // The cursor left the field, by Tab or a click elsewhere.
    callback focus-lost();

    public function focus-input() {
        input.focus();
    }

    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.outline-active : hover.has-hover ? Theme.outline-hover : Theme.outline;
    background: Theme.field;

    hover := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    if root.text == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-size: Theme.body;
        color: Theme.text-disabled;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        font-size: Theme.body;
        color: root.enabled ? Theme.text : Theme.text-muted;
        selection-background-color: #8A6C3A;
        selection-foreground-color: Theme.gold-bright;
        vertical-alignment: center;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
        changed has-focus => {
            if !self.has-focus {
                root.focus-lost();
            }
        }
    }
}

// Scrollable column with a thin gold scrollbar instead of the platform one.
export component ScrollPanel inherits Rectangle {
    in property <length> spacing: 6px;
    property <length> bar: 6px;
    property <length> overflow: max(0px, flick.content-height - flick.height);
    property <length> thumb: overflow == 0 ? root.height : max(32px, root.height * root.height / flick.content-height);

    flick := Flickable {
        x: 0;
        y: 0;
        width: root.width - root.bar - 10px;
        height: root.height;
        content-height: max(content.preferred-height, self.height);
        content := VerticalLayout {
            width: flick.width;
            spacing: root.spacing;
            alignment: start;
            @children
        }
    }

    if root.overflow > 0 : Rectangle {
        x: root.width - root.bar;
        y: 0;
        width: root.bar;
        height: root.height;
        border-radius: root.bar / 2;
        border-width: 1px;
        border-color: Theme.line;

        Rectangle {
            x: 0;
            y: (-flick.content-y / root.overflow) * (root.height - root.thumb);
            width: root.bar;
            height: root.thumb;
            border-radius: root.bar / 2;
            background: track.has-hover || track.pressed ? Theme.outline-hover : Theme.outline;
        }

        track := TouchArea {
            width: parent.width + 8px;
            x: -4px;
            height: parent.height;
            function jump() {
                flick.content-y = -clamp((self.mouse-y - root.thumb / 2) / (root.height - root.thumb), 0, 1) * root.overflow;
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.jump();
                }
            }
            moved => {
                if (self.pressed) {
                    self.jump();
                }
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    height: 20px;
    width: label.preferred-width + 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.outline;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.gold;
    }
}

// Square tick box in the gold outline style; the tick is a filled square, no glyph needed.
export component PickBox inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    // Off: dimmed and does not react.
    in property <bool> enabled: true;
    callback toggled();

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    opacity: root.enabled ? 1 : 0.4;
    width: Theme.touch ? 44px : 24px;
    height: self.width;

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: Theme.radius;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.outline;
        background: Theme.field;
        if root.checked : Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: Theme.gold;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    focus := FocusScope {
        width: 0;
        height: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled();
                return accept;
            }
            reject
        }
    }
}

// A choice from a list in the game's look, instead of the platform combo box: a field with a gold
// chevron, the list in a panel below it. Up and Down change the choice without opening the list.
export component Dropdown inherits Rectangle {
    // What the closed field shows for each choice.
    in property <[string]> model;
    // Optional, per choice: the text in the open list, and its place in a group (0 plain, 1 heads a
    // group, 2 belongs to the group above), as the website lists subcategories.
    in property <[string]> list-labels;
    in property <[int]> levels;
    in-out property <int> current-index;
    callback selected(int);

    property <length> item-height: Theme.touch ? 44px : 34px;

    function pick(index: int) {
        if (index >= 0 && index < root.model.length && index != root.current-index) {
            root.current-index = index;
            root.selected(index);
        }
    }

    accessible-role: combobox;
    accessible-value: root.model[root.current-index];
    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.outline-active : touch.has-hover ? Theme.outline-hover : Theme.outline;
    background: Theme.field;

    Text {
        x: 12px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.model[root.current-index];
        font-size: Theme.body;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }

    Path {
        x: parent.width - 22px;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: "M 0.5 0.5 L 5 5 L 9.5 0.5";
        stroke: touch.has-hover ? Theme.gold-bright : Theme.gold;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            popup.show();
        }
    }

    focus := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.pick(root.current-index + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pick(root.current-index - 1);
                return accept;
            }
            if (event.text == " " || event.text == Key.Return) {
                popup.show();
                return accept;
            }
            reject
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.model.length, 8) * root.item-height + 2px;

        Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.outline;
            background: Theme.bg;

            ScrollPanel {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                spacing: 0;

                for label[index] in root.model : Rectangle {
                    height: root.item-height;
                    background: index == root.current-index ? Theme.crimson : item.has-hover ? Theme.row-hover : transparent;

                    property <int> level: index < root.levels.length ? root.levels[index] : 0;
                    Text {
                        x: parent.level == 2 ? 32px : 12px;
                        width: parent.width - self.x - 4px;
                        height: parent.height;
                        text: index < root.list-labels.length ? root.list-labels[index] : label;
                        font-size: Theme.body;
                        color: index == root.current-index ? Theme.gold-bright
                            : item.has-hover || parent.level == 1 ? Theme.gold : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(index); }
                    }
                }
            }
        }
    }
}

// The addon's icon, or its initial in a gold-rimmed square while there is none.
component AddonIcon inherits Rectangle {
    in property <image> icon;
    in property <string> initial;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.outline;
    background: Theme.field;
    clip: true;
    if root.icon.width == 0 : Text {
        width: parent.width;
        height: parent.height;
        text: root.initial;
        font-size: parent.height / 2;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.gold-heading;
    }
    if root.icon.width > 0 : Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: root.icon;
        image-fit: cover;
    }
}

// A grey surface that slowly pulses where content is still on its way, instead of a "Loading" text.
component Placeholder inherits Rectangle {
    accessible-role: none;
    background: Theme.line;
    border-radius: Theme.radius;
    opacity: 0.45 + 0.3 * sin(animation-tick() / 1.2s * 360deg);
}

// A screenshot or description image, at most `tallest` tall; a click asks to enlarge it.
component Picture inherits Rectangle {
    in property <image> source;
    in property <string> caption;
    in property <length> tallest: 360px;
    callback enlarge();
    property <float> ratio: root.source.width > 0 ? root.source.height / root.source.width : 0.5625;
    height: min(root.tallest, root.width * root.ratio);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.outline-hover : Theme.line;
    background: Theme.field;
    clip: true;
    accessible-role: button;
    accessible-label: root.caption != "" ? "Enlarge " + root.caption : "Enlarge picture";
    if root.source.width == 0 : Placeholder {
        width: parent.width;
        height: parent.height;
    }
    Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: root.source;
        image-fit: contain;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.source.width > 0 ? pointer : default;
        clicked => {
            if (root.source.width > 0) {
                root.enlarge();
            }
        }
    }
}

// One block of a description, styled as the website styles it.
export component AboutBlockView inherits VerticalLayout {
    in property <AboutBlock> block;
    callback enlarge(image, string);
    padding-top: root.block.kind == 1 ? 8px : 0px;
    if root.block.kind == 0 || root.block.kind == 1 : Text {
        text: root.block.text;
        font-family: root.block.kind == 1 ? Theme.font-display : Theme.font-body;
        font-size: root.block.kind == 1 ? Theme.heading : Theme.body;
        color: root.block.kind == 1 ? Theme.gold : Theme.text;
        wrap: word-wrap;
    }
    // Wrapping text never goes into a HorizontalLayout: Slint measures its height there as one
    // unbroken line, and everything below would slide into it. A fixed width measures it right.
    if root.block.kind == 2 : Rectangle {
        height: item.preferred-height;
        Text {
            x: 6px;
            y: 0;
            text: root.block.marker;
            font-size: Theme.body;
            color: Theme.gold;
        }
        item := Text {
            x: 28px;
            y: 0;
            width: parent.width - self.x;
            text: root.block.text;
            font-size: Theme.body;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
    if root.block.kind == 3 : Rectangle {
        background: Theme.field;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;
        height: code.preferred-height + 20px;
        code := Text {
            x: 10px;
            width: parent.width - 20px;
            text: root.block.text;
            font-family: "Consolas";
            font-size: Theme.meta;
            color: Theme.gold-bright;
            wrap: word-wrap;
        }
    }
    if root.block.kind == 4 : Rectangle {
        height: quote.preferred-height;
        Rectangle {
            x: 0;
            width: 3px;
            height: parent.height;
            background: Theme.outline;
        }
        quote := Text {
            x: 15px;
            y: 0;
            width: parent.width - self.x;
            text: root.block.text;
            font-size: Theme.body;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
    if root.block.kind == 5 : Picture {
        source: root.block.image;
        caption: root.block.text;
        enlarge => { root.enlarge(root.block.image, root.block.text); }
    }
}

// One fact of the detail view: a gold label over its text.
export component Fact inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: Theme.body;
        color: Theme.gold;
    }
    Text {
        text: root.text;
        font-size: Theme.body;
        color: Theme.text;
        wrap: word-wrap;
    }
}

// The addon a row was clicked for: name and action on top, then the facts and the description.
export component DetailView inherits VerticalLayout {
    in property <AddonDetail> detail;
    callback back();
    callback action();
    callback remove();
    callback open();
    callback website();
    // A page of the addon on the website or GitHub: "bug", "issues", "abuse".
    callback link(string);
    // The sub page, as on the website: 0 Overview, 1 Issues, 2 Comments, 3 Versions. Only the
    // Overview is drawn here; the app places the other pages under the view.
    in-out property <int> tab;
    callback tab-changed(int);
    // The browser cannot open here (Game Mode): the website buttons are greyed out.
    in property <bool> links-enabled: true;
    // Scan the installed folders with forge-scan on this computer.
    callback scan();
    // Switch updating on its own on or off for this addon.
    callback auto-update();
    // Screenshot `index` was clicked, or a picture of the description: show it large.
    callback enlarge-shot(int);
    callback enlarge(image, string);

    spacing: 14px;

    HorizontalLayout {
        alignment: start;
        LinkButton {
            text: "< Back to the list";
            clicked => { root.back(); }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            AddonIcon {
                width: 64px;
                height: 64px;
                icon: root.detail.row.icon;
                initial: root.detail.row.initial;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.detail.row.name;
                    font-size: 26px;
                    color: Theme.gold-heading;
                    overflow: elide;
                }
                if root.detail.row.badge != "" : VerticalLayout {
                    alignment: center;
                    Pill { text: root.detail.row.badge; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: (root.detail.row.author != "" ? "by " + root.detail.row.author : "")
                    + (root.detail.category != "" ? "   " + root.detail.category : "")
                    + (root.detail.row.version != "" ? "   " + root.detail.row.version : "");
                font-size: Theme.meta;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: root.detail.row.status;
                font-size: Theme.body;
                horizontal-alignment: right;
                color: root.detail.row.busy ? Theme.text-muted
                    : root.detail.row.status-kind == 1 ? Theme.ok
                    : root.detail.row.status-kind == 2 ? Theme.warn
                    : root.detail.row.status-kind == 3 ? Theme.danger
                    : Theme.text-muted;
            }
            if root.detail.row.busy && root.detail.row.progress >= 0 : ProgressBar {
                value: root.detail.row.progress;
            }
            if root.detail.row.action != "" : ActionButton {
                text: root.detail.row.action;
                primary: true;
                large: true;
                enabled: !root.detail.row.busy;
                clicked => { root.action(); }
            }
        }
    }

    // Icons named by their tooltips: the addon's own places and this computer first, then, as on
    // the website, bugs, the discussion and a report to the admins. Writing needs the website's
    // GitHub login; the launcher has none.
    HorizontalLayout {
        alignment: start;
        spacing: Theme.gap-tight;
        if root.detail.on-website : GlyphButton {
            label: "Open on the website";
            // A globe.
            glyph: "M 1.5 8 A 6.5 6.5 0 0 1 14.5 8 A 6.5 6.5 0 0 1 1.5 8 Z M 1.5 8 L 14.5 8 M 8 1.5 C 5 4.5 5 11.5 8 14.5 M 8 1.5 C 11 4.5 11 11.5 8 14.5";
            enabled: root.links-enabled;
            clicked => { root.website(); }
        }
        if root.detail.row.can-open : GlyphButton {
            label: "GitHub";
            // Code brackets.
            glyph: "M 5 4 L 1.5 8 L 5 12 M 11 4 L 14.5 8 L 11 12 M 9.5 2.5 L 6.5 13.5";
            enabled: root.links-enabled;
            clicked => { root.open(); }
        }
        if root.detail.row.can-remove && !root.detail.row.busy : GlyphButton {
            label: "Scan locally";
            // A magnifier.
            glyph: "M 1.5 6.5 A 5 5 0 0 1 11.5 6.5 A 5 5 0 0 1 1.5 6.5 Z M 10.1 10.1 L 14.5 14.5";
            clicked => { root.scan(); }
        }
        if root.detail.row.can-remove && !root.detail.row.busy : RemoveButton {
            label: "Remove " + root.detail.row.name;
            clicked => { root.remove(); }
        }
        if root.detail.on-website : Rectangle {
            width: 1px;
            background: Theme.line;
        }
        if root.detail.on-website : GlyphButton {
            label: root.detail.bug-label;
            // A bug: body, head line and legs.
            glyph: "M 4.5 8.5 A 3.5 4.5 0 0 1 11.5 8.5 A 3.5 4.5 0 0 1 4.5 8.5 Z M 8 5 L 8 13 M 6 4.5 L 5 2 M 10 4.5 L 11 2 M 4.5 7 L 1.5 6 M 11.5 7 L 14.5 6 M 4.6 10.5 L 1.5 11.5 M 11.4 10.5 L 14.5 11.5";
            enabled: root.links-enabled;
            clicked => { root.link("bug"); }
        }
        if root.detail.on-website && root.detail.issues-ready : GlyphButton {
            label: "Issues";
            // A ring with a dot, as GitHub marks an issue.
            glyph: "M 1.5 8 A 6.5 6.5 0 0 1 14.5 8 A 6.5 6.5 0 0 1 1.5 8 Z M 7 8 A 1 1 0 0 1 9 8 A 1 1 0 0 1 7 8 Z";
            enabled: root.links-enabled;
            clicked => { root.link("issues"); }
        }
        if root.detail.on-website : GlyphButton {
            label: "Report abuse";
            // A flag.
            glyph: "M 3.5 15 L 3.5 1.5 M 3.5 2.5 L 13 2.5 L 10.5 6 L 13 9.5 L 3.5 9.5";
            enabled: root.links-enabled;
            clicked => { root.link("abuse"); }
        }
        if root.detail.on-website && !root.links-enabled : VerticalLayout {
            alignment: center;
            Text {
                text: "The website opens in Desktop Mode.";
                font-size: Theme.meta;
                color: Theme.text-muted;
            }
        }
    }

    if root.detail.can-auto-update : HorizontalLayout {
        alignment: start;
        spacing: 10px;
        PickBox {
            label: "Update automatically";
            enabled: !root.detail.auto-update-all;
            checked: root.detail.auto-update;
            toggled => { root.auto-update(); }
        }
        Text {
            text: root.detail.auto-update-all ? "Updates automatically (switched on for all addons in the settings)" : "Update automatically when the platform found nothing in a new version";
            font-size: Theme.body;
            color: root.detail.auto-update-all ? Theme.text-muted : Theme.text;
            vertical-alignment: center;
        }
    }

    if root.detail.row.warning != "" : Text {
        text: root.detail.row.warning;
        font-size: Theme.body;
        color: Theme.danger;
        wrap: word-wrap;
    }

    if root.detail.on-website : HorizontalLayout {
        alignment: start;
        spacing: Theme.gap-tight;
        TabButton {
            text: "Overview";
            active: root.tab == 0;
            clicked => { root.open-tab(0); }
        }
        if root.detail.issues-ready : TabButton {
            text: "Issues";
            active: root.tab == 1;
            clicked => { root.open-tab(1); }
        }
        if root.detail.comments-on : TabButton {
            text: "Comments";
            active: root.tab == 2;
            clicked => { root.open-tab(2); }
        }
        TabButton {
            text: "Versions";
            active: root.tab == 3;
            clicked => { root.open-tab(3); }
        }
    }

    function open-tab(tab: int) {
        if root.tab != tab {
            root.tab = tab;
            root.tab-changed(tab);
        }
    }

    if root.tab == 0 : ScrollPanel {
        vertical-stretch: 1;
        spacing: 18px;
        // Screenshots first, then the description, as on the website.
        if root.detail.shots.length > 0 : Text {
            text: "Screenshots";
            font-size: Theme.body;
            color: Theme.gold;
        }
        // A grid like the website's: as many columns of at least 240px as fit, wrapping.
        if root.detail.shots.length > 0 : Rectangle {
            property <length> gap: 12px;
            property <int> columns: max(1, floor((self.width + self.gap) / (240px + self.gap)));
            property <length> cell: (self.width - (self.columns - 1) * self.gap) / self.columns;
            property <length> row-height: self.cell * 9 / 16 + 24px;
            height: ceil(root.detail.shots.length / self.columns) * (self.row-height + self.gap) - self.gap;
            for shot[i] in root.detail.shots : VerticalLayout {
                x: mod(i, parent.columns) * (parent.cell + parent.gap);
                y: floor(i / parent.columns) * (parent.row-height + parent.gap);
                width: parent.cell;
                height: parent.row-height;
                spacing: 4px;
                Picture {
                    source: shot.image;
                    caption: shot.caption;
                    height: parent.width * 9 / 16;
                    enlarge => { root.enlarge-shot(i); }
                }
                Text {
                    text: shot.caption;
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            spacing: 10px;
            Text {
                text: "About";
                font-size: Theme.body;
                color: Theme.gold;
            }
            for block in root.detail.about : AboutBlockView {
                block: block;
                enlarge(image, caption) => { root.enlarge(image, caption); }
            }
            // The rest of the description is on its way: three lines of placeholder.
            if root.detail.about-loading : VerticalLayout {
                spacing: 8px;
                accessible-role: text;
                accessible-label: "Loading the description";
                Placeholder { height: 12px; }
                HorizontalLayout {
                    Placeholder { height: 12px; horizontal-stretch: 9; }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    Placeholder { height: 12px; horizontal-stretch: 6; }
                    Rectangle { horizontal-stretch: 4; }
                }
            }
        }
        if root.detail.safety != "" : Fact {
            label: "Safety check";
            text: root.detail.safety;
        }
        if root.detail.game != "" : Fact {
            label: "Game version";
            text: root.detail.game;
        }
        if root.detail.folders != "" : Fact {
            label: "Folders";
            text: root.detail.folders;
        }
        if root.detail.needs != "" : Fact {
            label: "Needs";
            text: root.detail.needs;
        }
    }
}

export component AddonRowView inherits Rectangle {
    in property <AddonRow> addon;
    callback action();
    callback remove();
    callback open();
    callback pick();
    // The row itself was clicked: open the detail view.
    callback details();

    // Touch: room for the 44px action button and 44px links stacked in the last column.
    height: Theme.touch ? 104px : 84px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: hover.has-hover ? Theme.outline : Theme.line;
    background: hover.has-hover ? Theme.row-hover : Theme.row;

    hover := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.details(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        if root.addon.can-pick : VerticalLayout {
            alignment: center;
            PickBox {
                checked: root.addon.picked;
                label: "Pick " + root.addon.name + " for a pack";
                toggled => { root.pick(); }
            }
        }

        VerticalLayout {
            alignment: center;
            AddonIcon {
                width: 50px;
                height: 50px;
                icon: root.addon.icon;
                initial: root.addon.initial;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.addon.name;
                    font-size: Theme.heading;
                    color: Theme.gold-heading;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Pill { text: root.addon.badge; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: (root.addon.author != "" ? "by " + root.addon.author + "   " : "") + root.addon.version;
                font-size: Theme.meta;
                color: Theme.text-muted;
                overflow: elide;
            }
            Text {
                text: root.addon.warning != "" ? root.addon.warning : root.addon.description;
                font-size: Theme.meta;
                color: root.addon.warning != "" ? Theme.danger : Theme.text;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.addon.status;
                font-size: Theme.meta;
                horizontal-alignment: right;
                color: root.addon.busy ? Theme.text-muted
                    : root.addon.status-kind == 1 ? Theme.ok
                    : root.addon.status-kind == 2 ? Theme.warn
                    : root.addon.status-kind == 3 ? Theme.danger
                    : Theme.text-muted;
            }
            if root.addon.busy && root.addon.progress >= 0 : ProgressBar {
                value: root.addon.progress;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: Theme.touch ? 160px : 124px;
            if root.addon.action != "" : ActionButton {
                text: root.addon.action;
                primary: root.addon.status-kind == 2;
                enabled: !root.addon.busy;
                clicked => { root.action(); }
            }
            // GitHub fills the column, so it lines up with the Update button above; the bin stays square.
            HorizontalLayout {
                spacing: 6px;
                if root.addon.can-open : ActionButton {
                    horizontal-stretch: 1;
                    text: "GitHub";
                    clicked => { root.open(); }
                }
                if root.addon.can-remove && !root.addon.busy : RemoveButton {
                    label: "Remove " + root.addon.name;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// Tiles or a list, as on the website: two halves of one outlined control, the chosen one lit.
export component ViewToggle inherits Rectangle {
    in-out property <bool> tiles;
    callback changed(bool);

    // As tall as the search field beside it.
    height: Theme.touch ? 44px : 38px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.outline;
    clip: true;

    HorizontalLayout {
        for half[i] in [{ label: "Tiles", on: true }, { label: "List", on: false }] : Rectangle {
            property <bool> lit: root.tiles == half.on;
            accessible-role: button;
            accessible-label: half.label;
            accessible-checked: self.lit;
            // Icons only, named by their tooltip: each half as wide as the toggle is high.
            width: root.height;
            background: self.lit || touch.has-hover ? Theme.control : transparent;
            if i == 1 : Rectangle {
                x: 0;
                width: 1px;
                background: Theme.line;
            }
            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 16;
                viewbox-height: 16;
                // Four squares, or three bars, drawn as outlines so the gaps stay visible.
                commands: half.on ? "M 1.5 1.5 L 6.5 1.5 L 6.5 6.5 L 1.5 6.5 Z M 9.5 1.5 L 14.5 1.5 L 14.5 6.5 L 9.5 6.5 Z M 1.5 9.5 L 6.5 9.5 L 6.5 14.5 L 1.5 14.5 Z M 9.5 9.5 L 14.5 9.5 L 14.5 14.5 L 9.5 14.5 Z"
                    : "M 1 3 L 15 3 M 1 8 L 15 8 M 1 13 L 15 13";
                stroke: lit ? Theme.gold-bright : touch.has-hover ? Theme.gold : Theme.text-muted;
                stroke-width: 1.6px;
            }
            // The lit half carries a gold line under it.
            if lit : Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.gold;
            }
            touch := TipArea {
                tip: half.label;
                mouse-cursor: pointer;
                clicked => {
                    if (!lit) {
                        root.tiles = half.on;
                        root.changed(half.on);
                    }
                }
            }
        }
    }
}

// An addon as a tile: the icon large on top, then name, author, summary, its state and buttons.
export component AddonTileView inherits Rectangle {
    in property <AddonRow> addon;
    callback action();
    callback remove();
    callback open();
    callback pick();
    callback details();

    // Below the icon: name, author, two lines of summary, badge and state, the main button, the rest.
    out property <length> body-height: Theme.touch ? 256px : 212px;

    border-radius: Theme.radius;
    border-width: 1px;
    border-color: hover.has-hover ? Theme.outline : Theme.line;
    background: hover.has-hover ? Theme.row-hover : Theme.row;
    clip: true;

    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.details(); }
    }

    AddonIcon {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.width;
        border-radius: 0;
        border-width: 0;
        icon: root.addon.icon;
        initial: root.addon.initial;
    }
    if root.addon.can-pick : PickBox {
        x: 10px;
        y: 10px;
        checked: root.addon.picked;
        label: "Pick " + root.addon.name + " for a pack";
        toggled => { root.pick(); }
    }
    Rectangle {
        y: parent.width - 1px;
        height: 1px;
        background: Theme.line;
    }

    VerticalLayout {
        y: parent.width;
        height: root.body-height;
        padding: 10px;
        spacing: 4px;
        Text {
            text: root.addon.name;
            font-size: 17px;
            color: Theme.gold-heading;
            overflow: elide;
        }
        Text {
            text: (root.addon.author != "" ? "by " + root.addon.author + "   " : "") + root.addon.version;
            font-size: Theme.meta;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            height: 36px;
            text: root.addon.warning != "" ? root.addon.warning : root.addon.description;
            font-size: Theme.meta;
            color: root.addon.warning != "" ? Theme.danger : Theme.text;
            wrap: word-wrap;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            height: 22px;
            if root.addon.badge != "" : VerticalLayout {
                alignment: center;
                Pill { text: root.addon.badge; }
            }
            Text {
                horizontal-stretch: 1;
                text: root.addon.status;
                font-size: Theme.meta;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
                color: root.addon.busy ? Theme.text-muted
                    : root.addon.status-kind == 1 ? Theme.ok
                    : root.addon.status-kind == 2 ? Theme.warn
                    : root.addon.status-kind == 3 ? Theme.danger
                    : Theme.text-muted;
            }
        }
        if root.addon.busy && root.addon.progress >= 0 : ProgressBar {
            value: root.addon.progress;
        }
        Rectangle { vertical-stretch: 1; }
        if root.addon.action != "" : ActionButton {
            text: root.addon.action;
            primary: root.addon.status-kind == 2;
            enabled: !root.addon.busy;
            clicked => { root.action(); }
        }
        HorizontalLayout {
            spacing: 6px;
            if root.addon.can-open : ActionButton {
                horizontal-stretch: 1;
                text: "GitHub";
                clicked => { root.open(); }
            }
            if root.addon.can-remove && !root.addon.busy : RemoveButton {
                label: "Remove " + root.addon.name;
                clicked => { root.remove(); }
            }
        }
    }
}

// Tiles in as many columns of at least 170px as fit, like the website's grid. A column stays below the
// 256px of the platform's icons in a normal window, so they are shown smaller, never blown up.
export component AddonTiles inherits Rectangle {
    in property <[AddonRow]> rows;
    callback action(string);
    callback remove(string);
    callback open(string);
    callback pick(string);
    callback details(string);

    property <length> gap: 12px;
    property <int> columns: max(1, floor((self.width + self.gap) / (170px + self.gap)));
    property <length> cell: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> tile-height: self.cell + (Theme.touch ? 256px : 212px);
    height: ceil(root.rows.length / self.columns) * (self.tile-height + self.gap) - self.gap;

    for row[i] in root.rows : AddonTileView {
        x: mod(i, root.columns) * (root.cell + root.gap);
        y: floor(i / root.columns) * (root.tile-height + root.gap);
        width: root.cell;
        height: root.tile-height;
        addon: row;
        action => { root.action(row.id); }
        remove => { root.remove(row.id); }
        open => { root.open(row.id); }
        pick => { root.pick(row.id); }
        details => { root.details(row.id); }
    }
}

// Full-window dim layer that swallows clicks to the UI below and centers its child.
export component Overlay inherits Rectangle {
    background: Theme.overlay;
    TouchArea {
        width: parent.width;
        height: parent.height;
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            @children
        }
    }
}

// Panel with a gold-brown rim, used for the main content area.
export component Panel inherits Rectangle {
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.panel;
}

export component DialogCard inherits Rectangle {
    in property <string> title;
    width: 500px;
    height: layout.preferred-height;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.outline;
    background: Theme.panel;
    layout := VerticalLayout {
        padding: Theme.gap-loose;
        spacing: 18px;
        SectionHeading {
            text: root.title;
            size: 24px;
        }
        @children
    }
}

// One caption button (minimize, maximize/restore, close), sized like the Windows ones.
component CaptionButton inherits Rectangle {
    in property <string> label;
    // 0 minimize, 1 maximize, 2 restore, 3 close
    in property <int> glyph;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    width: 46px;
    background: !touch.has-hover ? transparent
        : root.glyph == 3 ? Theme.crimson-hover
        : touch.pressed ? Theme.bg : Theme.control;

    property <brush> stroke: touch.has-hover ? Theme.gold-bright : Theme.text-muted;

    if root.glyph == 0 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 5 L 10 5";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.glyph == 1 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.glyph == 2 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.glyph == 3 : Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: root.stroke;
        stroke-width: 1px;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// Replaces the system window frame: drag area, double-click to maximize, caption buttons.
export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximized;
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close();

    height: 34px;
    background: Theme.bg;

    drag := TouchArea {
        width: parent.width;
        height: parent.height;
        // Dragging starts on the first move, so a double-click still reaches us.
        moved => {
            if (self.pressed) {
                root.start-drag();
            }
        }
        double-clicked => { root.toggle-maximize(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        Text {
            text: root.title;
            font-family: Theme.font-display;
            font-size: 14px;
            color: Theme.gold;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        CaptionButton {
            label: "Minimize";
            glyph: 0;
            clicked => { root.minimize(); }
        }
        CaptionButton {
            label: root.maximized ? "Restore" : "Maximize";
            glyph: root.maximized ? 2 : 1;
            clicked => { root.toggle-maximize(); }
        }
        CaptionButton {
            label: "Close";
            glyph: 3;
            clicked => { root.close(); }
        }
    }
}

component ResizeGrip inherits TouchArea {
    in property <int> direction;
    callback start(int);
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.start(root.direction);
        }
    }
}

// Invisible strips along the window edges that start a native resize, since a frameless
// window has no system border to grab. Directions: 0 N, 1 S, 2 E, 3 W, 4 NE, 5 NW, 6 SE, 7 SW.
export component ResizeEdges {
    in property <length> grip: 5px;
    callback start-resize(int);

    ResizeGrip { x: root.grip; y: 0; width: root.width - 2 * root.grip; height: root.grip; direction: 0; mouse-cursor: ns-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.grip; y: root.height - root.grip; width: root.width - 2 * root.grip; height: root.grip; direction: 1; mouse-cursor: ns-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.width - root.grip; y: root.grip; width: root.grip; height: root.height - 2 * root.grip; direction: 2; mouse-cursor: ew-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: 0; y: root.grip; width: root.grip; height: root.height - 2 * root.grip; direction: 3; mouse-cursor: ew-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.width - root.grip; y: 0; width: root.grip; height: root.grip; direction: 4; mouse-cursor: nesw-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: 0; y: 0; width: root.grip; height: root.grip; direction: 5; mouse-cursor: nwse-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: root.width - root.grip; y: root.height - root.grip; width: root.grip; height: root.grip; direction: 6; mouse-cursor: nwse-resize; start(d) => { root.start-resize(d); } }
    ResizeGrip { x: 0; y: root.height - root.grip; width: root.grip; height: root.grip; direction: 7; mouse-cursor: nesw-resize; start(d) => { root.start-resize(d); } }
}

// The comments of an addon, read only: writing and replying need the website's GitHub login.
// While the platform answers, placeholders show (after 150 ms, `waiting` 1) and from 5 s a word
// that the connection is slow (`waiting` 2).
export component CommentsView inherits VerticalLayout {
    in property <string> name;
    in property <[CommentRow]> rows;
    in property <int> waiting;
    in property <bool> failed;
    in property <bool> off;
    in property <bool> more;
    in property <bool> loading-more;
    in property <bool> links-enabled: true;
    // A tab of the detail view: its header names the addon, so no back link and title here.
    in property <bool> embedded;
    callback back();
    callback write();
    callback older();
    callback retry();

    spacing: 14px;

    if !root.embedded : HorizontalLayout {
        alignment: start;
        LinkButton {
            text: "< Back to " + root.name;
            clicked => { root.back(); }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            if !root.embedded : Text {
                text: "Comments";
                font-size: 26px;
                color: Theme.gold-heading;
            }
            Text {
                text: root.links-enabled ? "Write and reply on the website, with your GitHub login." : "Write and reply on the website in Desktop Mode.";
                font-size: Theme.meta;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            ActionButton {
                text: "Write a comment";
                primary: true;
                enabled: root.links-enabled;
                clicked => { root.write(); }
            }
        }
    }

    ScrollPanel {
        vertical-stretch: 1;
        spacing: 12px;
        if root.off : Text {
            text: "The creator has not turned on comments.";
            font-size: Theme.body;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        if root.failed : HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.rows.length > 0 ? "Older comments could not be loaded." : "Comments could not be loaded. Check the connection.";
                font-size: Theme.body;
                color: Theme.danger;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            ActionButton {
                text: "Try again";
                clicked => { root.retry(); }
            }
        }
        if !root.off && !root.failed && root.waiting == 0 && root.rows.length == 0 && !root.loading-more : Text {
            text: "No comments yet.";
            font-size: Theme.body;
            color: Theme.text-muted;
        }
        for row in root.rows : HorizontalLayout {
            padding-left: row.depth * 24px;
            Rectangle {
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: Theme.radius;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    if row.deleted : Text {
                        text: "Deleted comment.";
                        font-size: Theme.body;
                        color: Theme.text-muted;
                    }
                    if !row.deleted : HorizontalLayout {
                        spacing: 8px;
                        AddonIcon {
                            width: 24px;
                            height: 24px;
                            icon: row.avatar;
                            initial: row.initial;
                        }
                        Text {
                            text: row.author;
                            font-size: Theme.body;
                            color: Theme.gold;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.date + (row.edited ? " · edited" : "");
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    // A Rectangle around the wrapping text: a HorizontalLayout would measure it as one line.
                    if !row.deleted : Rectangle {
                        height: body.preferred-height;
                        body := Text {
                            width: parent.width;
                            text: row.body;
                            font-size: Theme.body;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        // Comments on their way: three placeholder cards in the shape of a comment.
        if root.waiting > 0 : VerticalLayout {
            spacing: 12px;
            accessible-role: text;
            accessible-label: "Loading the comments";
            if root.waiting == 2 : Text {
                text: "Still loading. The connection seems slow.";
                font-size: Theme.meta;
                color: Theme.text-muted;
            }
            for i in 3 : VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    Placeholder { height: 14px; horizontal-stretch: 3; }
                    Rectangle { horizontal-stretch: 7; }
                }
                Placeholder { height: 12px; }
                HorizontalLayout {
                    Placeholder { height: 12px; horizontal-stretch: 6; }
                    Rectangle { horizontal-stretch: 4; }
                }
            }
        }
        if root.more && !root.failed : HorizontalLayout {
            alignment: start;
            ActionButton {
                text: root.loading-more ? "Loading" : "Older comments";
                enabled: !root.loading-more;
                clicked => { root.older(); }
            }
        }
    }
}

// A list page of the detail view while it loads, after it failed, or with nothing in it.
component ListState inherits VerticalLayout {
    in property <bool> loading;
    in property <bool> failed;
    in property <bool> empty;
    in property <string> what;
    in property <string> none;
    callback retry();

    spacing: 8px;
    if root.loading : VerticalLayout {
        spacing: 8px;
        accessible-role: text;
        accessible-label: "Loading the " + root.what;
        for i in 3 : Placeholder { height: 40px; }
    }
    if root.failed : HorizontalLayout {
        spacing: 12px;
        Text {
            text: "The " + root.what + " could not be loaded. Check the connection.";
            font-size: Theme.body;
            color: Theme.danger;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ActionButton {
            text: "Try again";
            clicked => { root.retry(); }
        }
    }
    if !root.loading && !root.failed && root.empty : Text {
        text: root.none;
        font-size: Theme.body;
        color: Theme.text-muted;
    }
}

// The Issues tab: the open issues, each opening on the website, where writing needs its login.
export component IssuesView inherits VerticalLayout {
    in property <[IssueLine]> rows;
    in property <int> open-count;
    in property <bool> loading;
    in property <bool> failed;
    in property <bool> links-enabled: true;
    // An issue's number, or 0 for the whole list on the website.
    callback open(int);
    callback report();
    callback retry();

    spacing: 12px;

    HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.loading ? "Open issues" : root.open-count == 1 ? "1 open issue" : root.open-count + " open issues";
            font-size: Theme.body;
            color: Theme.gold;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        LinkButton {
            text: "All issues on the website";
            clicked => { root.open(0); }
        }
        ActionButton {
            text: "Report a bug";
            primary: true;
            enabled: root.links-enabled;
            clicked => { root.report(); }
        }
    }
    ScrollPanel {
        vertical-stretch: 1;
        spacing: 6px;
        ListState {
            loading: root.loading;
            failed: root.failed;
            empty: root.rows.length == 0;
            what: "issues";
            none: "No open issues.";
            retry => { root.retry(); }
        }
        for issue in root.rows : Rectangle {
            accessible-role: button;
            accessible-label: "#" + issue.number + " " + issue.title;
            height: 52px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: touch.has-hover && root.links-enabled ? Theme.outline-hover : Theme.line;
            background: touch.has-hover && root.links-enabled ? Theme.row-hover : Theme.row;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: issue.title;
                        font-size: Theme.body;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: "#" + issue.number + " opened " + issue.date + (issue.author != "" ? " by " + issue.author : "");
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
                if issue.comments > 0 : Text {
                    text: issue.comments == 1 ? "1 comment" : issue.comments + " comments";
                    font-size: Theme.meta;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                enabled: root.links-enabled;
                mouse-cursor: pointer;
                clicked => { root.open(issue.number); }
            }
        }
    }
}

// The Versions tab: every version the platform knows, newest first.
export component VersionsView inherits VerticalLayout {
    in property <[VersionLine]> rows;
    in property <bool> loading;
    in property <bool> failed;
    callback retry();

    spacing: 12px;

    Text {
        text: "Versions";
        font-size: Theme.body;
        color: Theme.gold;
    }
    ScrollPanel {
        vertical-stretch: 1;
        spacing: 6px;
        ListState {
            loading: root.loading;
            failed: root.failed;
            empty: root.rows.length == 0;
            what: "versions";
            none: "No versions yet.";
            retry => { root.retry(); }
        }
        for version in root.rows : Rectangle {
            height: 52px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.row;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: version.name + (version.prerelease ? "  (pre-release)" : "");
                        font-size: Theme.body;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: version.date + "   " + (version.downloads == 1 ? "1 download" : version.downloads + " downloads");
                        font-size: Theme.meta;
                        color: Theme.text-muted;
                    }
                }
                Text {
                    text: version.trust;
                    font-size: Theme.meta;
                    vertical-alignment: center;
                    color: version.trust-kind == 1 ? Theme.ok : version.trust-kind == 2 ? Theme.warn : version.trust-kind == 3 ? Theme.danger : Theme.text-muted;
                }
            }
        }
    }
}