# Local test setup (docs/local-setup.md). Copy to .env.local and fill in the four GitHub values.

# The containers read their settings from this file too.
FORGE_ENV_FILE=.env.local
POSTGRES_PASSWORD=local-only-password
# With http:// Caddy serves plain HTTP on these ports, no certificates.
DOMAIN_WEB=http://localhost:3080
DOMAIN_API=http://localhost:3081
ACME_EMAIL=local@example.com

PUBLIC_API_URL=http://localhost:3081
PUBLIC_WEB_URL=http://localhost:3080
PUBLIC_IMAGE_URL=http://localhost:3080/img
PUBLIC_PACK_URL=http://localhost:3080/packs-files
AUTH_RETURN_URLS=http://localhost:3080/auth/callback
MIGRATE_ON_START=true
COOKIE_KEY=local-only-cookie-key-0123456789abcdef0123456789

# From your test GitHub App (docs/local-setup.md, step 1).
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-local.pem
# The local API gets no webhooks; any value works.
GITHUB_WEBHOOK_SECRET=local-only-webhook-secret
# Your numeric GitHub user ID (https://api.github.com/users/<login> -> id): you become admin.
ADMIN_GITHUB_IDS=

# Monitoring (`--profile monitoring`, docs/local-setup.md).
GRAFANA_DB_PASSWORD=local-only-grafana-reader
GRAFANA_ADMIN_PASSWORD=local-only-grafana-admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
