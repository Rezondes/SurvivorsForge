# SurvivorsForge platform configuration. Copy to `.env` and fill in.
# `.env` is git-ignored; never commit real values.

# --- Docker Compose ---
# Password of the Postgres database (Compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=change-me
# Sites Caddy serves over plain HTTP on the ports compose.yaml publishes; TLS ends in front of the
# server (Cloudflare). With a bare domain and ports 80/443 Caddy gets certificates itself.
DOMAIN_WEB=http://forge.rezondes.net:3080
DOMAIN_API=http://forgeapi.rezondes.net:3081
# Contact address for Let's Encrypt, used only when Caddy gets certificates itself.
ACME_EMAIL=admin@example.com
# Subnet of the edge network and Caddy's fixed address in it; change them if they clash with
# another Docker network on the host.
FORGE_EDGE_SUBNET=10.213.17.0/24
FORGE_CADDY_IP=10.213.17.10
FORGE_WEB_IP=10.213.17.11
# Path on the host to the GitHub App's private key; mounted as a secret.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem

# --- forge-api ---
# Postgres connection string.
DATABASE_URL=postgres://forge:change-me@postgres:5432/forge
# Public base URL of the API, without trailing slash.
PUBLIC_API_URL=https://forgeapi.rezondes.net
# Address the API listens on inside the container.
BIND_ADDR=0.0.0.0:8080
# Address of the Prometheus metrics (/metrics) of the API and the worker. Only the monitoring
# network reaches it; Caddy never forwards it.
METRICS_BIND_ADDR=0.0.0.0:9100
# Apply database migrations when `forge-api serve` starts.
MIGRATE_ON_START=true
# Requests per minute and client IP.
RATE_LIMIT_PER_MINUTE=120
# Seconds public answers (addon list, registry, ...) stay in the API's memory; 0 turns it off.
CACHE_SECONDS=60
# Folder the API stores uploaded images in (a volume the reverse proxy serves read-only).
IMAGE_DIR=/data/images
# Public base URL of uploaded images (served by the reverse proxy), without trailing slash.
PUBLIC_IMAGE_URL=https://forge.rezondes.net/img

# --- Addon packs ---
# Folder the worker stores built packs in (a volume the reverse proxy serves read-only).
PACK_DIR=/data/packs
# Public base URL of that folder, without trailing slash.
PUBLIC_PACK_URL=https://forge.rezondes.net/packs-files
# Most addons in one pack.
PACK_MAX_ADDONS=20
# Largest pack zip in MB (all verified addons together are about 37 MB).
PACK_MAX_MB=50
# New packs per user and hour.
PACKS_PER_HOUR=10
# Days a built pack is kept without a download; the next download builds it again.
PACK_RETENTION_DAYS=7
# All built packs together in MB; above it the least recently downloaded are deleted.
PACK_STORAGE_MB=2048

# How many versions the 6-hourly source check compares with GitHub per run.
SOURCE_CHECK_BATCH=200
# Password of the read-only database role grafana_reader, for Grafana's Postgres data source
# (`docker compose --profile monitoring`). Empty: the role cannot log in.
GRAFANA_DB_PASSWORD=
# Password of Grafana's own admin account; with the Forge login (Grafana behind /grafana/) it is
# only needed in an emergency.
GRAFANA_ADMIN_PASSWORD=change-me
# GitHub repository of the launcher itself; /stats shows the downloads of its releases.
LAUNCHER_REPO=Rezondes/SurvivorsForge
# Comma-separated IPs of reverse proxies whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=
# Address of the website (Compose sets it): it limits each visitor itself, so the API does not
# count its requests again. Empty: every request counts.
WEBSITE_IP=

# --- GitHub App (see docs/self-hosting.md) ---
# GitHub REST API base URL.
GITHUB_API_URL=https://api.github.com
# Optional token for public reads of repos without the App (addons from their own account, the repo
# search). Without it GitHub allows 60 requests per hour, with it 5000. A fine-grained token with
# "Public repositories (read-only)" access and no permissions is enough.
GITHUB_READ_TOKEN=
# Numeric App ID from the App's settings page.
GITHUB_APP_ID=123456
# The App's private key: either the PEM text (newlines as \n) ...
GITHUB_APP_PRIVATE_KEY=
# ... or a path to the .pem file inside the container.
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Secret entered in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=change-me
# Base URL for GitHub's OAuth pages.
GITHUB_OAUTH_URL=https://github.com
# Client ID and client secret of the GitHub App (for user logins).
GITHUB_CLIENT_ID=Iv1.0000000000000000
GITHUB_CLIENT_SECRET=change-me

# --- Login and roles ---
# Comma-separated, exact client callback URLs a login may return to (the website's /auth/callback).
AUTH_RETURN_URLS=https://forge.rezondes.net/auth/callback
# Comma-separated numeric GitHub user IDs that are admins (https://api.github.com/users/<login> -> id).
ADMIN_GITHUB_IDS=
# Comma-separated roles that see the detailed statistics on /admin/stats (admin, moderator).
# Moderators are given on the website by an admin; there is no list of them here.
ADMIN_STATS_ROLES=admin,moderator

# --- forge-web ---
# Where the website reaches the API inside the Compose network.
API_INTERNAL_URL=http://api:8080
# Public base URL of the website, without trailing slash.
PUBLIC_WEB_URL=https://forge.rezondes.net
# At least 32 random characters; encrypts the session cookies (e.g. `openssl rand -hex 32`).
COOKIE_KEY=change-me-to-64-random-hex-characters-change-me-change-me-0000
# URL name of the GitHub App (github.com/apps/<slug>), for the "install the App" link.
GITHUB_APP_SLUG=survivorsforge
# Address the website listens on inside its container.
WEB_BIND_ADDR=0.0.0.0:8080
# Address of the website's Prometheus metrics (/metrics); only the monitoring network reaches it.
WEB_METRICS_BIND_ADDR=0.0.0.0:9100
