// Toasts for Slint apps, without imports: the app gives the colours and the font size.

// One toast as the Rust `Toasts` keeps it. kind: 0 info, 1 success, 2 warning, 3 error, 4 busy.
export struct Toast {
    id: int,
    text: string,
    kind: int,
    // A button in the toast ("Undo"); empty without one.
    action: string,
}

// Colours and sizes of the toasts; the defaults are a plain dark look.
export struct ToastStyle {
    background: brush,
    border: color,
    text: color,
    muted: color,
    info: color,
    success: color,
    warning: color,
    error: color,
    busy: color,
    font-size: length,
    radius: length,
    // The close button's edge: 26px, 44px for touch screens.
    close-size: length,
}

component CloseButton inherits Rectangle {
    in property <color> glyph;
    in property <color> hover;
    in property <length> size: 26px;
    callback clicked();

    accessible-role: button;
    accessible-label: "Close message";
    width: root.size;
    height: root.size;
    border-radius: 3px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: root.hover;

    Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 2 2 L 10 10 M 10 2 L 2 10";
        stroke: touch.has-hover ? root.hover : root.glyph;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component ToastAction inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <length> font-size;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    width: label.preferred-width + 16px;
    height: max(label.preferred-height + 8px, 26px);
    border-radius: 3px;
    border-width: 1px;
    border-color: touch.has-hover ? root.tint : transparent;
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: root.font-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Copies the text of an error toast, to paste it into a bug report; says "Copied" for a moment.
component CopyButton inherits Rectangle {
    in property <string> text;
    in property <color> glyph;
    in property <color> hover;
    in property <color> done;
    in property <length> size: 26px;
    property <bool> copied;

    accessible-role: button;
    accessible-label: root.copied ? "Copied" : "Copy message";
    accessible-action-default => { root.copy(); }
    width: root.size;
    height: root.size;
    border-radius: 3px;

    function copy() {
        holder.text = root.text;
        holder.select-all();
        holder.copy();
        holder.clear-selection();
        root.copied = true;
    }

    // Holds the text while it is copied; never seen.
    holder := TextInput {
        width: 0;
        height: 0;
        read-only: true;
    }
    Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
    // Two sheets, or a tick once copied.
    Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.copied ? "M 2 6.5 L 5 9.5 L 10 3" : "M 4 4 L 11 4 L 11 11 L 4 11 Z M 8 1 L 1 1 L 1 8";
        stroke: root.copied ? root.done : touch.has-hover ? root.hover : root.glyph;
        stroke-width: 1.5px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.copy(); }
    }
}

// One toast. Info and success go after `done-time`, a warning or an error stays until it is closed,
// a busy one shows a running bar until its work finishes.
component ToastCard inherits Rectangle {
    in property <Toast> toast;
    in property <ToastStyle> style;
    in property <duration> done-time;
    // How long a toast with a button stays: long enough to press it.
    in property <duration> action-time;
    in property <bool> busy-closable;
    in property <bool> errors-copyable;
    callback dismiss(int);
    callback action(int);

    property <bool> closable: root.toast.kind != 4 || root.busy-closable;
    property <bool> copyable: root.toast.kind == 3 && root.errors-copyable;
    property <length> close-room: (root.closable ? root.style.close-size : 0px) + (root.copyable ? root.style.close-size + 4px : 0px)
        + (root.toast.action != "" ? button.width + 8px : 0px);
    property <color> accent: [root.style.info, root.style.success, root.style.warning, root.style.error, root.style.busy][root.toast.kind];

    accessible-role: text;
    accessible-label: root.toast.text;
    // Not a HorizontalLayout: Slint measures wrapping text there as one line.
    height: max(message.preferred-height, root.style.close-size) + 20px;
    border-radius: root.style.radius;
    border-width: 1px;
    border-color: root.toast.kind == 2 || root.toast.kind == 3 ? root.accent : root.style.border;
    background: root.style.background;
    drop-shadow-blur: 12px;
    drop-shadow-color: #000000B0;
    clip: true;

    // Starts when a busy toast turns into info or success: its time starts with its result.
    Timer {
        interval: root.toast.action != "" ? max(root.done-time, root.action-time) : root.done-time;
        running: root.toast.kind <= 1;
        triggered => { root.dismiss(root.toast.id); }
    }
    Rectangle {
        x: 6px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1px;
        background: root.accent;
    }
    message := Text {
        x: 20px;
        y: (parent.height - self.height) / 2;
        width: parent.width - self.x - root.close-room - 20px;
        height: self.preferred-height;
        text: root.toast.text;
        font-size: root.style.font-size;
        color: root.style.text;
        wrap: word-wrap;
    }
    button := ToastAction {
        x: parent.width - 10px - (root.closable ? root.style.close-size + 4px : 0px) - (root.copyable ? root.style.close-size + 4px : 0px) - self.width;
        y: (parent.height - self.height) / 2;
        visible: root.toast.action != "";
        text: root.toast.action;
        tint: root.accent;
        font-size: root.style.font-size;
        clicked => { root.action(root.toast.id); }
    }
    if root.copyable : CopyButton {
        x: parent.width - 10px - (root.closable ? root.style.close-size + 4px : 0px) - self.width;
        y: (parent.height - self.height) / 2;
        text: root.toast.text;
        glyph: root.style.muted;
        hover: root.style.text;
        done: root.style.success;
        size: root.style.close-size;
    }
    if root.closable : CloseButton {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        glyph: root.style.muted;
        hover: root.style.text;
        size: root.style.close-size;
        clicked => { root.dismiss(root.toast.id); }
    }
    // Work without a known end: a short bar runs along the bottom edge.
    if root.toast.kind == 4 : Rectangle {
        property <float> phase: mod(animation-tick() / 1.4s, 1);
        x: (root.width + self.width) * self.phase - self.width;
        y: root.height - self.height;
        width: root.width / 3;
        height: 2px;
        background: root.accent;
    }
}

// The toasts stacked, newest at the bottom; place it where they should show (bottom right).
export component ToastStack inherits VerticalLayout {
    in property <[Toast]> toasts;
    in property <ToastStyle> style: {
        background: #1E1E22,
        border: #3A3A42,
        text: #ECECEC,
        muted: #9A9AA2,
        info: #5AA9E6,
        success: #4CC36A,
        warning: #E5B83B,
        error: #E0574A,
        busy: #9A9AA2,
        font-size: 14px,
        radius: 4px,
        close-size: 26px,
    };
    in property <duration> done-time: 4s;
    in property <duration> action-time: 10s;
    // True: an error toast has a button that copies its text.
    in property <bool> errors-copyable: false;
    // False: a busy toast has no X, so running work cannot be closed.
    in property <bool> busy-closable: true;
    callback dismiss(int);
    // The button of the toast `id` was pressed.
    callback action(int);

    spacing: 8px;
    alignment: end;
    for toast in root.toasts : ToastCard {
        toast: toast;
        style: root.style;
        done-time: root.done-time;
        action-time: root.action-time;
        busy-closable: root.busy-closable;
        errors-copyable: root.errors-copyable;
        dismiss(id) => { root.dismiss(id); }
        action(id) => { root.action(id); }
    }
}
